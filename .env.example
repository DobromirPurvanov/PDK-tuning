# Копира се като .env до docker-compose.yml. Нищо от това не влиза в хранилището.
# Мерене (само на живия домейн; на new.pdktuning.com се оставя празно)
PUBLIC_GTM_ID=
# Защита на формата (Cloudflare Turnstile) — публичен ключ за страницата и таен за API-то
PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# Писмата от формата (Resend)
RESEND_API_KEY=
MAIL_FROM=PDK Tuning <noreply@pdktuning.com>
MAIL_TO=
MAIL_CC=
# Старият сървър с портала за файлове (/bg/login, /en/login, профил). Днес е живият сайт.
# Когато www.pdktuning.com мине на новия сайт, тук се слага името/адресът на стария сървър (напр. https://legacy.pdktuning.com).
LEGACY_UPSTREAM=https://www.pdktuning.com
