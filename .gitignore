node_modules/
dist/
.astro/
.crawl/
.env
.env.*
!.env.example
*.log
.DS_Store

# Следите, които деплоят оставя на сървъра. Без тези редове `git status` там
# изглежда като че ли някой е пипал хранилището на ръка — а това са артефакти
# на `scripts/deploy/activate.sh` и са напълно очаквани.
# Коментарът върви на свой ред: `.gitignore` няма коментари в средата на реда,
# а „шаблон + интервали + #…“ не съвпада с нищо и правилото мълчаливо не важи.

# тагът и комитът, които в момента вървят
ACTIVE-VERSION
# заключване срещу два едновременни деплоя
.deploy.lock
# имената на образите от последния УСПЕШЕН деплой
.images.env
# съставът, с който в момента вървят контейнерите
.compose.active.yml
# стоварените пакети (images.tar, images.env, compose)
releases/

# Наряди на каскадата — работни файлове, не част от сайта
.kaskada/

# CSP-то се генерира при билда от готовия dist (scripts/csp-hashes.mjs).
# Комитнат файл тук би остарял при първата промяна по скрипт и щеше да
# спре точно тези скриптове — мълчаливо, само в браузъра.
docker/nginx/csp.inc

# This file contains only the two public deployment origins.
!site/.env.local
