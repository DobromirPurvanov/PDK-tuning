# ═════════════════════════════════════════════════════════════════════════════
# `new.pdktuning.com` ПОКАЗВА НОВИЯ САЙТ, не този.
#
# Новият сайт живее на Cloudflare Pages (проект `new-pdk`). Правилният път
# натам е един CNAME запис, но зоната `pdktuning.com` не е в нашия акаунт и
# записът минава през IT-то на клиента — тоест не зависи от нас и чакаше.
#
# Дотогава заявките за това име се ПРЕПРЕДАВАТ оттук. Адресът в браузъра
# остава `new.pdktuning.com`, съдържанието е новото. Когато CNAME-ът се
# направи, този блок спира да се задейства сам — заявките вече няма да
# стигат до този сървър — и се маха при първото чистене.
#
# Прокси, не 301: пренасочване щеше да смени адреса в браузъра и всеки, на
# когото се показва сайтът, щеше да вижда друго име.
#
# `Host` е `new-pdk.pages.dev`, защото Pages избира проекта по него. Порталът
# на дилърите НЕ се пипа тук — новият сайт сам препредава `/bg/login` към
# стария сървър, а двойно проксиране би изгубило сесията.
#
# Заглавките за сигурност НЕ се добавят: Pages праща свои и вторият комплект
# ги дублира (nginx не замества чужди `add_header`, а трупа).
# ═════════════════════════════════════════════════════════════════════════════
server {
  listen 80;
  server_name new.pdktuning.com;

  # Cloudflare Pages иска SNI и валиден Host; резолверът е нужен, защото името
  # се разрешава при заявката, а не при зареждане на конфига.
  resolver 1.1.1.1 8.8.8.8 valid=300s;
  resolver_timeout 5s;

  location / {
    set $pages "new-pdk.pages.dev";
    proxy_pass https://$pages$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $pages;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Accept-Encoding "";
    proxy_ssl_server_name on;
    proxy_ssl_name $pages;
    # `manual`: 301/302 от новия сайт стигат до браузъра както са — той сам
    # знае кои са неговите адреси, а пренаписването тук би счупило портала.
    proxy_redirect off;
    proxy_read_timeout 30s;
    proxy_connect_timeout 10s;
  }
}

# Сервира dist/ от Astro (build.format = directory: /bg/bmw → /bg/bmw/index.html, /bg/ → /bg/index.html).
# ${LEGACY_UPSTREAM} се замества при старт на контейнера (env).
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  absolute_redirect off;
  include /etc/nginx/headers.inc;

  # R2: коренът → българската версия; R3 за началните: /bg → /bg/
  location = / { return 301 /bg/; }
  location = /bg { return 301 /bg/; }
  location = /en { return 301 /en/; }

  # R4: главни букви → малки (един път)
  if ($uri != $uri_lc) { return 301 $uri_lc$is_args$args; }
  # матрицата на пренасочванията
  if ($redir) { return 301 $redir; }

  # R3: наклонената черта в края се маха (освен /bg/ и /en/)
  location ~ ^/(bg|en)/(.+)/$ { return 301 /$1/$2$is_args$args; }

  # Порталът за файлове остава на стария сървър (план, стр. 34, вариант А — прокси)
  location ~ ^/(bg|en)/(login|logout|sign-up|signup|register|forgot-password|reset-password|profile|account|orders|order|upload|files|file|dashboard|google-login|oauth)(/.*)?$ {
    proxy_pass ${LEGACY_UPSTREAM};
    proxy_set_header Host www.pdktuning.com;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_ssl_server_name on;
    proxy_redirect off;
  }

  # Формата
  location /api/ {
    proxy_pass http://api:3000/api/;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $host;
  }

  # Активи с версия в името: една година
  location ~* ^/(_astro|fonts|logos)/ {
    include /etc/nginx/headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }
  location ~* ^/data/.*\.json$ {
    include /etc/nginx/headers.inc;
    add_header Cache-Control "public, max-age=86400";
    # The catalogue is also read from outside instead of being copied. Public
    # read-only data, so it is open to everyone.
    add_header Access-Control-Allow-Origin "*";
    add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS";
    if ($request_method = OPTIONS) { return 204; }
    try_files $uri =404;
  }

  # Страниците: кратък кеш, собствена 404 на езика
  location /bg/ {
    include /etc/nginx/headers.inc;
    add_header Cache-Control "public, max-age=600";
    error_page 404 /bg/404/index.html;
    try_files $uri $uri/index.html =404;
  }
  location /en/ {
    include /etc/nginx/headers.inc;
    add_header Cache-Control "public, max-age=600";
    error_page 404 /en/404/index.html;
    try_files $uri $uri/index.html =404;
  }
  location / {
    error_page 404 /bg/404/index.html;
    try_files $uri $uri/index.html =404;
  }
  location = /bg/404/index.html { internal; }
  location = /en/404/index.html { internal; }
}
