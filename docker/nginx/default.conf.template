# Сервира dist/ от Astro (build.format = directory: /bg/bmw → /bg/bmw/index.html, /bg/ → /bg/index.html).
# ${LEGACY_UPSTREAM} се замества при старт на контейнера (env).
server {
  # Единственият server блок; `default_server` е изричен, за да не се появи
  # мълчаливо подразбиране, ако някой ден се добави втори.
  listen 80 default_server;
  server_name _;
  root /usr/share/nginx/html;
  absolute_redirect off;
  include /etc/nginx/headers.inc;

  # ── ВСИЧКО, КОЕТО НЕ Е `www`/apex, ОТИВА НА НОВИЯ САЙТ ──────────────────
  #
  # Виж `map $host $to_new_site` в nginx.conf за това кой хост къде отива и
  # защо проверката не е по `server_name`.
  #
  # Прокси, не 301: пренасочване щеше да смени адреса в адресната лента и
  # всеки, на когото се показва сайтът, щеше да вижда друго име.
  #
  # `return 418` + `error_page` е стандартният начин за условно проксиране в
  # nginx: `proxy_pass` вътре в `if` не е позволен, а `if` на ниво server
  # изпълнява само пренасочване и връщане на код.
  resolver 1.1.1.1 8.8.8.8 valid=300s;
  resolver_timeout 5s;
  recursive_error_pages on;
  error_page 418 = @new_site;

  location @new_site {
    set $pages "new-pdk.pages.dev";
    proxy_pass https://$pages$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $pages;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    # без компресия: иначе тялото идва сгъстено, а тук няма кой да го разгъне
    proxy_set_header Accept-Encoding "";
    proxy_ssl_server_name on;
    proxy_ssl_name $pages;
    # 301/302 от новия сайт стигат до браузъра както са — той знае кои са
    # неговите адреси, а пренаписване тук би счупило портала на дилърите
    proxy_redirect off;
    proxy_connect_timeout 10s;
    proxy_read_timeout 30s;
  }

  # Условието стои ПРЕДИ всички правила на стария сайт: пренасочванията,
  # смъкването на главните букви и матрицата нямат работа по заявка, която
  # отива другаде.
  if ($to_new_site) { return 418; }

  # R2: коренът → българската версия; R3 за началните: /bg → /bg/
  location = / { return 301 /bg/; }
  location = /bg { return 301 /bg/; }
  location = /en { return 301 /en/; }

  # R4: главни букви → малки (един път)
  if ($uri != $uri_lc) { return 301 $uri_lc$is_args$args; }
  # матрицата на пренасочванията
  if ($redir) { return 301 $redir; }

  # R3: наклонената черта в края се маха (освен /bg/ и /en/)
  location ~ ^/(bg|en)/(.+)/$ { return 301 /$1/$2$is_args$args; }

  # Порталът за файлове остава на стария сървър (план, стр. 34, вариант А — прокси)
  location ~ ^/(bg|en)/(login|logout|sign-up|signup|register|forgot-password|reset-password|profile|account|orders|order|upload|files|file|dashboard|google-login|oauth)(/.*)?$ {
    proxy_pass ${LEGACY_UPSTREAM};
    proxy_set_header Host www.pdktuning.com;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_ssl_server_name on;
    proxy_redirect off;
  }

  # Формата
  location /api/ {
    proxy_pass http://api:3000/api/;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $host;
  }

  # Активи с версия в името: една година
  location ~* ^/(_astro|fonts|logos)/ {
    include /etc/nginx/headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }
  location ~* ^/data/.*\.json$ {
    include /etc/nginx/headers.inc;
    add_header Cache-Control "public, max-age=86400";
    # The catalogue is also read from outside instead of being copied. Public
    # read-only data, so it is open to everyone.
    add_header Access-Control-Allow-Origin "*";
    add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS";
    if ($request_method = OPTIONS) { return 204; }
    try_files $uri =404;
  }

  # Страниците: кратък кеш, собствена 404 на езика
  location /bg/ {
    include /etc/nginx/headers.inc;
    add_header Cache-Control "public, max-age=600";
    error_page 404 /bg/404/index.html;
    try_files $uri $uri/index.html =404;
  }
  location /en/ {
    include /etc/nginx/headers.inc;
    add_header Cache-Control "public, max-age=600";
    error_page 404 /en/404/index.html;
    try_files $uri $uri/index.html =404;
  }
  location / {
    error_page 404 /bg/404/index.html;
    try_files $uri $uri/index.html =404;
  }
  location = /bg/404/index.html { internal; }
  location = /en/404/index.html { internal; }
}
