# ── Средата на макета. Копира се като `.env` за местна работа, а в Cloudflare
#    Pages същите ключове се слагат в настройките на проекта.

# Пуска ли се обхождане. Докато не е `true`, всяка страница носи noindex,
# а robots.txt забранява всичко. Отваря се при пускане на истинския домейн.
PUBLIC_INDEXABLE=false

# GA4 маркер. ПРАЗНО в макета — демонстрационните посещения нямат работа в
# имота на клиента. Празно = скриптът на Google изобщо не се изписва.
#
# СТАРИЯТ САЙТ ВЕЧЕ МЕРИ: `G-13T4ZTVM1W` през `GTM-5MKF4JB` (проверено в
# страницата на www.pdktuning.com, 16.09.2026). Имотът е на клиента — в нашия
# акаунт (workdobromirjustpablo@) го НЯМА. При превключването на www има две
# възможности и те не са равностойни:
#   - същият маркер → историята на посещенията продължава непрекъсната, но
#     иска достъп до техния имот (или те да го сложат);
#   - нов имот → чист старт и нищо за сравнение отпреди.
# Първата е правилната, ако сайтът заема мястото на стария.
PUBLIC_GA_ID=

# Кодът за удостоверяване в Search Console — САМО съдържанието на `content`
# от мета тага, без обвивката. Празно = тагът не се изписва.
#
# СЪСТОЯНИЕ 16.09.2026: `pdktuning.com` НЕ е собственост в нашия акаунт — нито
# като домейн (`sc-domain:`), нито като адрес (`https://www.pdktuning.com/`).
# Старият сайт няма мета таг в страницата си, тоест ако клиентът има конзола,
# тя е потвърдена по друг начин и под техен профил.
#
# Този ключ върши работа за собственост от тип АДРЕС. За собственост от тип
# ДОМЕЙН (която покрива и www, и new, и всички поддомейни наведнъж и е
# по-добрата) трябва DNS запис — той минава през IT-то на клиента.
PUBLIC_GSC_VERIFY=

# ── Старият сайт (само за Worker-а) ───────────────────────────────────────
# ТОВА Е КЛЮЧЪТ ЗА ПРЕХВЪРЛЯНЕТО. Празно значи „още сме на свой адрес“:
# каталогът се чете от www.pdktuning.com, а техните пътища (/bg, /en, порталът)
# НЕ се подават никъде — /bg/… си остава нашата 404. Точно както беше досега.
#
# Записан адрес значи „вече стоим на тяхното място“ и включва две неща наведнъж:
# каталогът се чете оттам, и /bg, /en, /images, /vendor, /js, /css, /uploads,
# /storage се препредават на стария сайт, за да не се счупят ~9 000 индексирани
# адреса и входът на дилърите.
#
# Тогава www.pdktuning.com сме НИЕ, затова стойността НЕ бива да е www — иначе
# работникът пита сам себе си (има предпазител, който го спира с ясна грешка).
# Клиентът прави един DNS запис към същия произход — например catalog.pdktuning.com,
# ПРОКСИРАН през Cloudflare, за да има валиден сертификат.
LEGACY_ORIGIN=

# ── Формата за запитване (само за Worker-а, не се изписва в страницата) ──
# Без тези три ключа формата отговаря честно, че не е свързана.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
