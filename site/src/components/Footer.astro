---
/**
 * Долният ред. Беше един ред сив текст (`#4E544E` = контраст 2,58:1 — не се
 * четеше), после стана четири колони с котвите на началната. Сега сайтът има
 * страници, затова носи и втория ред връзки, който не се побра в лентата:
 * въпросите, мит/факт, статиите и порталът за партньори.
 */
import { NAV, MORE, LEGAL, BUSINESS as b, portalUrl } from '../config/site';
import { LEGAL_EN, MORE_EN, NAV_EN, langOf } from '../i18n';
import { dict } from '../i18n/ui';

const year = new Date().getFullYear();

const lang = langOf(Astro.url.pathname);
const t = dict(lang);
const en = lang === 'en';
const nav = en ? NAV_EN : NAV;
const more = en ? MORE_EN : MORE;
const legal = en ? LEGAL_EN : LEGAL;
const portal = portalUrl(lang);
const servicesHref = en ? '/en/services/' : '/uslugi/';

/**
 * Колоните с подниво. На български това са услугите и каталогът; на английски
 * каталог НЯМА (вж. бележката при `NAV_EN` в `src/i18n/index.ts`), а услугите
 * го получават чак когато английските им текстове са написани. `?.children`,
 * не `!` — докато наборът е празен, колоната просто не се рисува, вместо
 * билдът да падне върху удивителна.
 */
const services = nav.find((n) => n.href === servicesHref)?.children;
const catalog = en ? undefined : NAV.find((n) => n.href === '/katalog/')?.children;

const social = [
  { href: b.social.facebook, label: 'Facebook' },
  { href: b.social.instagram, label: 'Instagram' },
  { href: b.social.youtube, label: 'YouTube' },
];
---
<footer class="foot">
  <div class="foot-in">
    {/*
      ТЪРГОВСКАТА ИДЕНТИФИКАЦИЯ Е ЗАДЪЛЖИТЕЛНА, не украса: чл. 4 от Закона за
      електронната търговия иска наименование, седалище, адрес за кореспонденция,
      данни за контакт и номер на вписване. Затова стои на ВСЯКА страница, а не
      само в общите условия.

      ЕИК и ДДС номерът се четат от business.json. Празни са → редът НЕ СЕ
      РИСУВА. Дотук стоеше видима рамка „чака се“; тя вършеше работа, докато
      сайтът се гледаше отвътре, но пред посетител е признание за недовършеност.
      Щом дойдат от възложителя, редът се появява сам — нищо друго не се пипа.
      Ако е дошло само едното, излиза само то, без увиснал разделител.
    */}
    <address class="fcol">
      <p class="ftitle">{b.name}</p>
      <p class="fline">{b.legalName}</p>
      {(b.eik || b.vat) && (
        <p class="fline">
          {b.eik && <>{t.eik}: {b.eik}</>}
          {b.eik && b.vat && <span class="fsep" aria-hidden="true">·</span>}
          {b.vat && <>{t.vat}: {b.vat}</>}
        </p>
      )}
      {/* адресът има латинска форма в business.json — не се транслитерира тук */}
      <p class="fline">
        {en ? `${b.address.streetEn}, ${b.address.cityEn} ${b.address.postalCode}`
            : `${b.address.street}, ${b.address.city} ${b.address.postalCode}`}
      </p>
      <p class="fline"><a href={`tel:${b.phone}`}>{b.phoneDisplay}</a></p>
      <p class="fline"><a href={`mailto:${b.email}`}>{b.email}</a></p>
      <p class="fline" style="margin-top:14px">
        <a href={portal} target="_blank" rel="noopener noreferrer">{t.portal}</a>
      </p>
    </address>

    {/*
      ШЕСТ услуги, не осем. Тринайсетте са в падащото меню горе и на /uslugi/;
      тук са само най-търсените, за да не надвиши тази колона всички останали и
      да разтегли футъра заради себе си. „Всички услуги“ поема останалите.
    */}
    {services && (
      <nav class="fcol" aria-label={t.services}>
        <p class="ftitle"><a href={servicesHref}>{t.services}</a></p>
        {services.slice(0, 6).map((s) => <p class="fline"><a href={s.href}>{s.label}</a></p>)}
        <p class="fline"><a href={servicesHref}>{t.allServices}</a></p>
      </nav>
    )}

    {/*
      „Сайтът“ (Електрически, Цени, Как работим, За нас, Контакти) беше ТУК и
      преписваше лентата горе дума по дума — пет реда, които не водеха никого
      никъде. Махнат. Останалото в тази колона е каталогът, който наистина има
      подниво.
    */}
    {catalog && (
      <nav class="fcol" aria-label={t.catalog}>
        <p class="ftitle"><a href="/katalog/">{t.catalog}</a></p>
        {catalog.map((c) => <p class="fline"><a href={c.href}>{c.label}</a></p>)}
      </nav>
    )}

    {/*
      „Полезно“ остава на своето място, защото това е ЕДИНСТВЕНИЯТ вход към
      тези страници — в лентата горе ги няма. Правното и социалните слязоха в
      долния ред: те са по три думи всяка и вертикалният списък им отпускаше
      цяла колона за нищо.
    */}
    <nav class="fcol" aria-label={t.useful}>
      <p class="ftitle">{t.useful}</p>
      {more.map((m) => <p class="fline"><a href={m.href}>{m.label}</a></p>)}
    </nav>
  </div>

  <div class="foot-end">
    <nav class="fend-links" aria-label={t.legalAria}>
      {legal.map((l) => <a href={l.href}>{l.label}</a>)}
      {/* „Бисквитки“ до „Политика за бисквитки“ се четеше като две страници за
          едно и също. Това е бутон, който отваря избора — казва се какъв е. */}
      <button type="button" id="cookieOpen" class="linky">{t.cookieSettings}</button>
    </nav>

    <nav class="fend-links fend-social" aria-label={t.socialAria}>
      {social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
      ))}
    </nav>

    {/*
      ТУК СТОЕШЕ „Каталогът се чете на живо от pdktuning.com — тук не се пази
      копие.“ Това е бележка за устройството на сайта: на посетителя не му
      трябва, а сочи чужд домейн от всяка страница. Останалото е авторското
      право, което си е на място.
    */}
    <p class="fend-note">
      <span>© {year} {b.legalName}.</span>
    </p>
  </div>
</footer>

<style>
.foot{border-top:1px solid var(--line);padding:56px var(--gut) 28px;background:var(--bg-bar)}
/* На телефон трите колони с връзки стояха ЕДНА ПОД ДРУГА и футърът ставаше
   1330px — един екран и половина само за навигация. Заглавията им са по две
   думи, тоест се събират по две на ред и при 390px. Данните на фирмата остават
   на цял ред: адресът и имейлът не се пречупват добре в половин колона. */
.foot-in{max-width:1180px;margin:0 auto;display:grid;gap:30px 24px;grid-template-columns:1fr 1fr}
address.fcol{grid-column:1 / -1}
@media(min-width:980px){
  .foot-in{grid-template-columns:1.4fr 1fr 1fr 1fr;gap:34px 26px}
  address.fcol{grid-column:auto}
}

/* <address> носи наклонен шрифт по подразбиране — тук е блок с данни, не цитат */
address.fcol{font-style:normal}
.ftitle{margin:0 0 16px;font:400 var(--fz-lab)/1 var(--mono);letter-spacing:.24em;text-transform:uppercase;color:var(--lime)}
/* Разделителят е декоративен и е aria-hidden, но СЕ ВИЖДА — значи важи прагът
   за контраст. При .3 даваше 2,59:1 върху var(--bg-bar). Минималната алфа за 4,5:1
   на този фон е около 0,45; .5 оставя запас. */
.fsep{padding:0 6px;color:var(--ink-5)}
.ftitle a{border-bottom:1px solid transparent;transition:border-color var(--t-fast)}
.ftitle a:hover{border-bottom-color:var(--lime-line)}
.fline{margin:0;font:400 var(--fz-xs)/1.5 var(--body);color:var(--ink-4)}
.fline + .fline{margin-top:4px}
.fline a,.linky{display:inline-flex;align-items:center;min-height:32px;color:var(--ink-4);
  border:0;background:none;padding:0;cursor:pointer;text-align:left;font:inherit;
  border-bottom:1px solid transparent;transition:color var(--t-fast),border-color var(--t-fast)}
.fline a:hover,.linky:hover{color:var(--lime);border-bottom-color:var(--lime-line)}
/* заглавията на колоните вече са връзки („Услуги", „Каталог") — и те искат пръст */
@media(pointer:coarse){.fline a,.linky,.ftitle a{min-height:48px;display:inline-flex;align-items:center}}

/* Долният ред пое правното и социалните. Те са по три думи всяка и като
   вертикални списъци държаха цяла колона; наредени водоравно се събират на
   един-два реда. */
.foot-end{max-width:1180px;margin:30px auto 0;padding-top:18px;border-top:1px solid var(--line);
  display:flex;flex-wrap:wrap;align-items:center;gap:10px 28px}
.fend-links{display:flex;flex-wrap:wrap;gap:4px 20px;align-items:center}
.fend-links a,.fend-links .linky{font:400 var(--fz-2xs)/1.5 var(--body);color:var(--ink-4);
  border:0;background:none;padding:0;cursor:pointer;display:inline-flex;align-items:center;min-height:30px;
  border-bottom:1px solid transparent;transition:color var(--t-fast),border-color var(--t-fast)}
.fend-links a:hover,.fend-links .linky:hover{color:var(--lime);border-bottom-color:var(--lime-line)}
/* социалните се отделят от правните, за да не се четат като един списък */
.fend-social{margin-left:auto}
.fend-social a{font:400 var(--fz-lab)/1.5 var(--mono);letter-spacing:.14em;text-transform:uppercase}
.fend-note{flex-basis:100%;margin:2px 0 0;display:flex;flex-wrap:wrap;gap:4px 18px;
  font:400 var(--fz-btn)/1.6 var(--mono);color:var(--ink-5)}
@media(pointer:coarse){.fend-links a,.fend-links .linky{min-height:48px}}
@media(max-width:619px){
  .fend-social{margin-left:0}
  .fend-note{flex-direction:column;gap:4px}
}
</style>
