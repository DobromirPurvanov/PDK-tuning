---
/**
 * The bottom bar. It used to be one line of grey text (`#4E544E` = contrast 2.58:1 — it
 * could not be read), then became four columns with the home page anchors. Now the site has
 * pages, so it also carries the second row of links that did not fit in the bar:
 * the questions, myth/fact, the articles and the partner portal.
 */
import { NAV, MORE, LEGAL, BUSINESS as b, portalUrl } from '../config/site';
import { LEGAL_EN, MORE_EN, NAV_EN, langOf } from '../i18n';
import { dict } from '../i18n/ui';

const year = new Date().getFullYear();

const lang = langOf(Astro.url.pathname);
const t = dict(lang);
const en = lang === 'en';
const nav = en ? NAV_EN : NAV;
const more = en ? MORE_EN : MORE;
const legal = en ? LEGAL_EN : LEGAL;
const portal = portalUrl(lang);
const servicesHref = en ? '/en/services/' : '/uslugi/';

/**
 * The columns with a sub-level. In Bulgarian these are the services and the catalogue; in English
 * there is NO catalogue (see the note at `NAV_EN` in `src/i18n/index.ts`), and the services
 * get it only once their English texts are written. `?.children`,
 * not `!` — while the set is empty, the column is simply not drawn, instead of
 * the build failing on an exclamation mark.
 */
const services = nav.find((n) => n.href === servicesHref)?.children;
const catalog = en ? undefined : NAV.find((n) => n.href === '/katalog/')?.children;

const social = [
  { href: b.social.facebook, label: 'Facebook' },
  { href: b.social.instagram, label: 'Instagram' },
  { href: b.social.youtube, label: 'YouTube' },
];
---
<footer class="foot">
  <div class="foot-in">
    {/*
      THE COMMERCIAL IDENTIFICATION IS MANDATORY, not decoration: Art. 4 of the Electronic
      Commerce Act requires a name, registered seat, correspondence address,
      contact details and a registration number. That is why it appears on EVERY page, not
      only in the terms and conditions.

      The EIK and the VAT number are read from business.json. If they are empty → the row is NOT
      DRAWN. Until now a visible "pending" frame stood here; it did its job while
      the site was viewed from the inside, but in front of a visitor it is an admission of being unfinished.
      Once they arrive from the client, the row appears by itself — nothing else is touched.
      If only one has arrived, only that one is shown, without a dangling separator.
    */}
    <address class="fcol">
      <p class="ftitle">{b.name}</p>
      <p class="fline">{b.legalName}</p>
      {(b.eik || b.vat) && (
        <p class="fline">
          {b.eik && <>{t.eik}: {b.eik}</>}
          {b.eik && b.vat && <span class="fsep" aria-hidden="true">·</span>}
          {b.vat && <>{t.vat}: {b.vat}</>}
        </p>
      )}
      {/* the address has a Latin form in business.json — it is not transliterated here */}
      <p class="fline">
        {en ? `${b.address.streetEn}, ${b.address.cityEn} ${b.address.postalCode}`
            : `${b.address.street}, ${b.address.city} ${b.address.postalCode}`}
      </p>
      <p class="fline"><a href={`tel:${b.phone}`}>{b.phoneDisplay}</a></p>
      <p class="fline"><a href={`mailto:${b.email}`}>{b.email}</a></p>
      <p class="fline" style="margin-top:14px">
        <a href={portal} target="_blank" rel="noopener noreferrer">{t.portal}</a>
      </p>
    </address>

    {/*
      SIX services, not eight. The thirteen are in the dropdown menu at the top and on /uslugi/;
      here only the most sought-after, so this column does not exceed all the others and
      stretch the footer for its own sake. "All services" takes the rest.
    */}
    {services && (
      <nav class="fcol" aria-label={t.services}>
        <p class="ftitle"><a href={servicesHref}>{t.services}</a></p>
        {services.slice(0, 6).map((s) => <p class="fline"><a href={s.href}>{s.label}</a></p>)}
        <p class="fline"><a href={servicesHref}>{t.allServices}</a></p>
      </nav>
    )}

    {/*
      "The site" (Electric, Prices, How we work, About us, Contacts) used to be HERE and
      copied the bar at the top word for word — five rows that led nobody
      anywhere. Removed. What remains in this column is the catalogue, which really has
      a sub-level.
    */}
    {catalog && (
      <nav class="fcol" aria-label={t.catalog}>
        <p class="ftitle"><a href="/katalog/">{t.catalog}</a></p>
        {catalog.map((c) => <p class="fline"><a href={c.href}>{c.label}</a></p>)}
      </nav>
    )}

    {/*
      "Useful" stays in its place, because it is the ONLY entry to
      those pages — they are not in the bar at the top. The legal and social links moved down to the
      bottom row: they are three words each, and a vertical list gave them
      a whole column for nothing.
    */}
    <nav class="fcol" aria-label={t.useful}>
      <p class="ftitle">{t.useful}</p>
      {more.map((m) => <p class="fline"><a href={m.href}>{m.label}</a></p>)}
    </nav>
  </div>

  <div class="foot-end">
    <nav class="fend-links" aria-label={t.legalAria}>
      {legal.map((l) => <a href={l.href}>{l.label}</a>)}
      {/* "Cookies" next to "Cookie policy" read as two pages for
          the same thing. This is a button that opens the choice — it says what it is. */}
      <button type="button" id="cookieOpen" class="linky">{t.cookieSettings}</button>
    </nav>

    <nav class="fend-links fend-social" aria-label={t.socialAria}>
      {social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
      ))}
    </nav>

    {/*
      THERE USED TO BE "The catalogue is read live from pdktuning.com — no copy is
      kept here." That is a note about how the site is built: the visitor does not
      need it, and it points to a foreign domain from every page. What remains is the copyright,
      which belongs there.
    */}
    <p class="fend-note">
      <span>© {year} {b.legalName}.</span>
    </p>
  </div>
</footer>

<style>
.foot{border-top:1px solid var(--line);padding:56px var(--gut) 28px;background:var(--bg-bar)}
/* On a phone the three columns of links stood ONE UNDER ANOTHER and the footer became
   1330px — a screen and a half just for navigation. Their headings are two
   words each, so they fit two per row even at 390px. The company data stays
   on a full row: the address and the email do not wrap well in half a column. */
.foot-in{max-width:1180px;margin:0 auto;display:grid;gap:30px 24px;grid-template-columns:1fr 1fr}
address.fcol{grid-column:1 / -1}
@media(min-width:980px){
  .foot-in{grid-template-columns:1.4fr 1fr 1fr 1fr;gap:34px 26px}
  address.fcol{grid-column:auto}
}

/* <address> has an italic font by default — here it is a data block, not a quotation */
address.fcol{font-style:normal}
.ftitle{margin:0 0 16px;font:400 var(--fz-lab)/1 var(--mono);letter-spacing:.24em;text-transform:uppercase;color:var(--lime)}
/* The separator is decorative and aria-hidden, but it IS VISIBLE — so the contrast
   threshold applies. At .3 it gave 2.59:1 on var(--bg-bar). The minimum alpha for 4.5:1
   on this background is about 0.45; .5 leaves a margin. */
.fsep{padding:0 6px;color:var(--ink-5)}
.ftitle a{border-bottom:1px solid transparent;transition:border-color var(--t-fast)}
.ftitle a:hover{border-bottom-color:var(--lime-line)}
.fline{margin:0;font:400 var(--fz-xs)/1.5 var(--body);color:var(--ink-4)}
.fline + .fline{margin-top:4px}
.fline a,.linky{display:inline-flex;align-items:center;min-height:32px;color:var(--ink-4);
  border:0;background:none;padding:0;cursor:pointer;text-align:left;font:inherit;
  border-bottom:1px solid transparent;transition:color var(--t-fast),border-color var(--t-fast)}
.fline a:hover,.linky:hover{color:var(--lime);border-bottom-color:var(--lime-line)}
/* the column headings are now links ("Services", "Catalogue") — and they too want a finger */
@media(pointer:coarse){.fline a,.linky,.ftitle a{min-height:48px;display:inline-flex;align-items:center}}

/* The bottom row took over the legal and social links. They are three words each and as
   vertical lists they held a whole column; laid out horizontally they fit in
   one or two rows. */
.foot-end{max-width:1180px;margin:30px auto 0;padding-top:18px;border-top:1px solid var(--line);
  display:flex;flex-wrap:wrap;align-items:center;gap:10px 28px}
.fend-links{display:flex;flex-wrap:wrap;gap:4px 20px;align-items:center}
.fend-links a,.fend-links .linky{font:400 var(--fz-2xs)/1.5 var(--body);color:var(--ink-4);
  border:0;background:none;padding:0;cursor:pointer;display:inline-flex;align-items:center;min-height:30px;
  border-bottom:1px solid transparent;transition:color var(--t-fast),border-color var(--t-fast)}
.fend-links a:hover,.fend-links .linky:hover{color:var(--lime);border-bottom-color:var(--lime-line)}
/* the social links are separated from the legal ones, so they do not read as one list */
.fend-social{margin-left:auto}
.fend-social a{font:400 var(--fz-lab)/1.5 var(--mono);letter-spacing:.14em;text-transform:uppercase}
.fend-note{flex-basis:100%;margin:2px 0 0;display:flex;flex-wrap:wrap;gap:4px 18px;
  font:400 var(--fz-btn)/1.6 var(--mono);color:var(--ink-5)}
@media(pointer:coarse){.fend-links a,.fend-links .linky{min-height:48px}}
@media(max-width:619px){
  .fend-social{margin-left:0}
  .fend-note{flex-direction:column;gap:4px}
}
</style>
