---
/**
 * Главата на всяка страница — едно място за заглавие, описание, каноникъл,
 * споделяне и икони. Нито една страница не пише мета тагове сама.
 *
 * Каноникълът се смята от `site` в astro.config.mjs, а НЕ от адреса, на който
 * страницата е отворена — така макетът никога не сочи към localhost.
 */
import { SITE, INDEXABLE, EN_LIVE, GSC_VERIFY } from '../config/site';
import { alternates, langOf, LOCALE } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** снимка за споделяне, ако страницата има своя */
  image?: string;
  /** `article` за текстовите страници, `website` за началната */
  ogType?: 'website' | 'article';
  /** страници, които никога не се индексират (404) — независимо от флага */
  noindex?: boolean;
  /** структурирани данни; всеки обект се изписва като отделен JSON-LD блок */
  schema?: Record<string, unknown>[];
}

const { title, description, image = SITE.ogImage, ogType = 'website', noindex = false, schema = [] } = Astro.props;

// „/privacy" → „/privacy/" — билдът вади папки, каноникълът трябва да е същият адрес
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const lang = langOf(path);
/* Недопусната английска страница НЕ се индексира, дори когато сайтът е отворен
   за обхождане. Тя се изгражда (билдът е статичен и не знае условия), но не се
   сочи отникъде — а Google намира и несочени адреси. */
const hidden = noindex || (lang === 'en' && !EN_LIVE);
const robots = hidden || !INDEXABLE ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
/**
 * ДВОЙКИТЕ ЗА `hreflang`. Празен списък за страница, която съществува само на
 * един език — електрическите, статиите, PDK Flasher.
 *
 * `hreflang` със САМО един ред не значи нищо (Google го пропуска мълчаливо), а
 * алтернатива към адрес, който билдът не изгражда, е истинска грешка в Search
 * Console. Затова `alternates()` ги вади от ROUTES, а ROUTES знае само за
 * двойки, които съществуват и от двете страни.
 *
 * `x-default` сочи БЪЛГАРСКАТА страница: сервизът е във Варна и работи на
 * български; английската е за чуждия посетител, не обратното.
 */
const alts = hidden ? [] : alternates(path);
const xDefault = alts.find((a) => a.lang === 'bg');
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<title>{title}</title>
<meta name="description" content={description} />
{/* 404 няма собствен адрес — каноникъл към „/404/“ би сочил страница, която не е съдържание */}
{!noindex && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />
{alts.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site).href} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.href, Astro.site).href} />}
{/*
  Удостоверяването за Search Console. Празен ключ = тагът го няма изобщо —
  чужд или сгрешен код е по-лошо от липсващ. Виж бележката при GSC_VERIFY.
*/}
{GSC_VERIFY && <meta name="google-site-verification" content={GSC_VERIFY} />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={LOCALE[lang]} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:alt" content={SITE.ogImageAlt} />
<meta property="og:image:type" content={SITE.ogImageType} />
<meta property="og:image:width" content={String(SITE.ogImageW)} />
<meta property="og:image:height" content={String(SITE.ogImageH)} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={SITE.ogImageAlt} />
{/* Марката няма профил в X — `twitter:site` се изписва само ако бъде попълнен
    в site.ts. Празен или измислен хендъл е по-лош от липсващ. */}
{SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}
{SITE.twitterHandle && <meta name="twitter:creator" content={SITE.twitterHandle} />}

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content={SITE.themeColor} />
<meta name="apple-mobile-web-app-title" content={SITE.name} />

{schema.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}
