---
/**
 * The head of every page - one place for title, description, canonical,
 * sharing and icons. No page writes meta tags on its own.
 *
 * The canonical is computed from `site` in astro.config.mjs, NOT from the address the
 * page is opened on - so the mockup never points to localhost.
 */
import { SITE, INDEXABLE, EN_LIVE, GSC_VERIFY } from '../config/site';
import { alternates, langOf, LOCALE } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** image for sharing, if the page has its own */
  image?: string;
  /** `article` for text pages, `website` for the home page */
  ogType?: 'website' | 'article';
  /** pages that are never indexed (404) - regardless of the flag */
  noindex?: boolean;
  /** structured data; each object is written out as a separate JSON-LD block */
  schema?: Record<string, unknown>[];
}

const { title, description, image = SITE.ogImage, ogType = 'website', noindex = false, schema = [] } = Astro.props;

// "/privacy" → "/privacy/" - the build emits folders, the canonical must be the same address
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const lang = langOf(path);
/* An English page that is not allowed is NOT indexed, even when the site is open
      to crawling. It is built (the build is static and knows no conditions), but it is
      linked from nowhere - and Google finds unlinked addresses too. */
const hidden = noindex || (lang === 'en' && !EN_LIVE);
const robots = hidden || !INDEXABLE ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
/**
 * THE PAIRS FOR `hreflang`. An empty list for a page that exists in only
 * one language - the electric ones, the articles, PDK Flasher.
 *
 * `hreflang` with only ONE row means nothing (Google skips it silently), and an
 * alternate pointing to an address the build does not produce is a real error in Search
 * Console. That is why `alternates()` takes them from ROUTES, and ROUTES only knows about
 * pairs that exist on both sides.
 *
 * `x-default` points to the BULGARIAN page: the service is in Varna and works in
 * Bulgarian; the English one is for the foreign visitor, not the other way round.
 */
const alts = hidden ? [] : alternates(path);
const xDefault = alts.find((a) => a.lang === 'bg');
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<title>{title}</title>
<meta name="description" content={description} />
{/* 404 has no address of its own - a canonical to "/404/" would point to a page that is not content */}
{!noindex && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />
{alts.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site).href} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.href, Astro.site).href} />}
{/*
    Verification for Search Console. Empty key = the tag is absent altogether -
    a foreign or wrong code is worse than a missing one. See the note at GSC_VERIFY.
*/}
{GSC_VERIFY && <meta name="google-site-verification" content={GSC_VERIFY} />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={LOCALE[lang]} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:alt" content={SITE.ogImageAlt} />
<meta property="og:image:type" content={SITE.ogImageType} />
<meta property="og:image:width" content={String(SITE.ogImageW)} />
<meta property="og:image:height" content={String(SITE.ogImageH)} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={SITE.ogImageAlt} />
{/* The brand has no X profile - `twitter:site` is written only once one is filled in
        in site.ts. An empty or invented handle is worse than a missing one. */}
{SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}
{SITE.twitterHandle && <meta name="twitter:creator" content={SITE.twitterHandle} />}

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content={SITE.themeColor} />
<meta name="apple-mobile-web-app-title" content={SITE.name} />

{schema.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}
