---
/**
 * THE HOME PAGE PROMO WINDOW - the new electric-vehicle line.
 *
 * Built with `<dialog>` and `showModal()`, not our own `div`: the browser itself
 * traps the focus inside, returns focus to where it started, listens for Esc and
 * draws the backdrop. Writing all this by hand is thirty lines that
 * then do not work with a screen reader.
 *
 * FOUR RULES, so it is not annoying and does not eat rankings:
 *
 *     1. NOT immediately. Google counts a popup that greets a person from search
 *           as intrusive and demotes the page. This one waits 7 seconds or 40% scroll -
 *           by then the person is already reading the site, not the ad.
 *     2. NOT while the cookie question is open. That bar is also `aria-modal` and the two
 *           windows together are a dead end for a screen reader. It waits for the decision.
 *     3. ONCE. The showing is remembered for 14 days in localStorage. The version number
 *           lets the next campaign show again without waiting for expiry.
 *     4. NOT for a person who is already there. If the address is /elektricheski/, stay silent.
 *
 * The text does NOT promise numbers. Our numbers for the electric ones are not yet announced
 * (see OURS in src/data/ev.ts) and an ad is not the place to invent them.
 */
import { EV_COUNT, EV_BY_BRAND } from '../data/ev';

const brands = EV_BY_BRAND.map((b) => b.name).join(' · ');
---

<dialog class="promo panel" id="promo" aria-labelledby="promo-h">
  <form method="dialog" class="promo-x">
    <button value="close" aria-label="Затвори">✕</button>
  </form>

  <div class="promo-in">
    <p class="promo-kick">Ново направление</p>
    <h2 id="promo-h">Вече и за <em>електрически автомобили</em></h2>
    <p class="promo-p">
      Заводът продава един и същ агрегат в няколко мощности. Разликата е софтуер
      и се записва през телефона ви, без да идвате до Варна.
    </p>

    <ul class="promo-facts">
      <li><b>{EV_COUNT}</b><span>модела</span></li>
      <li><b>0</b><span>посещения в сервиз</span></li>
    </ul>

    <p class="promo-brands">{brands}</p>

    <div class="promo-act">
      <a class="btn btn--go promo-go" href="/elektricheski/">Вижте своя модел</a>
      <form method="dialog"><button class="promo-no" value="later">Не сега</button></form>
    </div>
  </div>
</dialog>

<script>
// Shown once, with a delay, and only after the cookie question
// is settled. Everything around it is a guard against it jumping in the face.
const dlg = document.getElementById('promo') as HTMLDialogElement | null;
if (dlg && !location.pathname.startsWith('/elektricheski')) {
  const KEY = 'pdk-promo';
  const V = 1;                       // bumped on a new campaign
  const DAYS = 14;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Is it already closed? A broken or unavailable localStorage means "show" -
   *   *  better a second time than never. */
  function seen() {
    try {
      const raw = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (!raw || raw.v !== V) return false;
      return Date.now() - raw.ts < DAYS * 864e5;
    } catch { return false; }
  }

  function remember() {
    try { localStorage.setItem(KEY, JSON.stringify({ v: V, ts: Date.now() })); } catch { /* no storage - it will simply show again */ }
  }

  if (!seen()) {
    let done = false;
    let waiting = false;

    /** Is the cookie bar present right now? Checked AT THE MOMENT OF OPENING,
     *       *  not once at the start: the two scripts are in one bundle and their order is not
     *       *  guaranteed - checked at the start, the bar may not have appeared yet. */
    const asking = () => {
      const bar = document.getElementById('cookieBar');
      return Boolean(bar && !bar.hidden);
    };

    const open = () => {
      if (done || dlg.open || seen()) return;
      if (asking()) {
        // wait for the decision and then open - once, not on every pass
        if (!waiting) {
          waiting = true;
          document.addEventListener('pdk:consent', () => setTimeout(open, 600), { once: true });
        }
        return;
      }
      done = true;
      window.removeEventListener('scroll', onScroll);
      // Remembered on SHOW, not on close: the CTA is a plain link and leaving the
      // page never fires `close`, so the promo kept coming back on every visit.
      remember();
      dlg.showModal();
      if (!calm) dlg.classList.add('in');
    };

    const onScroll = () => {
      const h = document.documentElement;
      const past = h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight);
      if (past > 0.4) open();
    };

    // A click OUTSIDE the panel closes it. `<dialog>` sends the event to itself
    // when the backdrop is hit - the panel inside stops it.
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close('backdrop'); });

    setTimeout(open, 7000);
    window.addEventListener('scroll', onScroll, { passive: true });
  }
}
</script>

<style>
.promo{
  width:min(92vw,520px);padding:0;color:var(--white);overflow:hidden;
  /* the browser centres a modal dialog itself; margin:auto preserves the old behaviours */
  margin:auto;
}
.promo::backdrop{background:var(--shade);backdrop-filter:blur(3px)}
.promo.in{animation:promo-up .3s cubic-bezier(.2,.7,.3,1)}
@keyframes promo-up{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

/* The slanted hairlines are the same mark the services section carries. */
.promo-in{position:relative;padding:34px 32px 30px}
.promo-in::before{content:'';position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(45deg,var(--hair) 0 1px,transparent 1px 8px);
  -webkit-mask-image:radial-gradient(120% 90% at 100% 0,#000 0%,transparent 65%);
  mask-image:radial-gradient(120% 90% at 100% 0,#000 0%,transparent 65%)}
.promo-in > *{position:relative}

.promo-x{position:absolute;top:10px;right:10px;z-index:2;margin:0}
.promo-x button{width:40px;height:40px;border-radius:var(--r-s);border:1px solid var(--line);
  background:var(--shade);color:var(--ink-3);cursor:pointer;display:grid;place-items:center;
  font:400 var(--fz-xs)/1 var(--mono);transition:var(--t-fast)}
.promo-x button:hover{border-color:var(--line-strong);color:var(--white)}

.promo-kick{margin:0 0 12px;font:400 var(--fz-lab)/1 var(--mono);letter-spacing:.3em;text-transform:uppercase;color:var(--lime)}
.promo h2{margin:0;font:700 clamp(30px,7vw,44px)/.98 var(--head);text-transform:uppercase;letter-spacing:-.015em}
.promo h2 em{font-style:normal;color:var(--lime)}
.promo-p{margin:14px 0 0;font:400 var(--fz-s)/1.55 var(--body);color:var(--ink-3)}

.promo-facts{display:flex;gap:28px;margin:22px 0 0;padding:18px 0 0;border-top:1px solid var(--line);list-style:none}
.promo-facts li{display:flex;align-items:baseline;gap:8px}
.promo-facts b{font:700 30px/1 var(--head);color:var(--white);font-variant-numeric:tabular-nums}
.promo-facts span{font:400 var(--fz-lab)/1.3 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-4)}

.promo-brands{margin:14px 0 0;font:400 var(--fz-btn)/1.6 var(--mono);letter-spacing:.1em;color:var(--ink-5)}

.promo-act{display:flex;align-items:center;gap:12px;margin-top:24px;flex-wrap:wrap}
.promo-act form{margin:0}
.promo-no{min-height:52px;padding:0 18px;border:0;background:none;cursor:pointer;
  font:400 var(--fz-btn)/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-4)}
.promo-no:hover{color:var(--white)}

/* On a phone it sits at the bottom as a sheet: the finger is at the bottom, not in the middle of the screen. */
@media(max-width:559px){
  .promo{width:100%;max-width:none;margin:auto 0 0;border-radius:var(--r-m) var(--r-m) 0 0;border-bottom:0}
  .promo.in{animation:promo-sheet .3s cubic-bezier(.2,.7,.3,1)}
  @keyframes promo-sheet{from{opacity:0;transform:translateY(100%)}to{opacity:1;transform:none}}
  .promo-in{padding:30px 22px 26px}
  .promo-act{gap:8px}
  .promo-go{flex:1}
}
</style>
