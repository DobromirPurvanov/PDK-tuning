---
/**
 * THE ENQUIRY FORM.
 *
 * Extracted from the home page because it now also lives on `/kontakti/`. Two copies of the
 * same script are how you end up with two different validations one day.
 *
 * Posts to `/api/contact` in public/_worker.js → Resend. Without the keys in the environment
 * the worker returns `not-configured` (503) and the page honestly says "not
 * connected, please call" - instead of showing a fake success.
 *
 * Protection has four layers and three of them are on the SERVER: a `pdk_extra` honeypot
 * (deliberately NOT "website" - password managers fill such a field and cut off
 * real people), a two-second threshold, an origin check and 5 requests per hour
 * per address.
 */
import { SERVICES } from '../data/services';
import { BUSINESS as b } from '../config/site';
import { SERVICES_EN } from '../i18n/en/services/index';
import { langOf } from '../i18n';
import { dict } from '../i18n/ui';
// The field styles are shared with the electric-vehicle order form - src/styles/form.css.
import '../styles/form.css';

interface Props {
  /** heading above the form; on the home page it belongs to the section, not here */
  heading?: string;
}
const { heading } = Astro.props;

const lang = langOf(Astro.url.pathname);
const t = dict(lang);
const en = lang === 'en';
const privacyHref = en ? '/en/privacy/' : '/privacy/';
/* The dropdown shows the English names if there are any; while `SERVICES_EN` is
      empty, the English form keeps "— choose —" and "Other" and nothing lies. */
const services = en ? SERVICES_EN : SERVICES;

/**
 * THE LABELS FOR THE SCRIPT travel as a single data attribute.
 *
 * A `<script>` in Astro is bundled separately and does NOT see the variables above.
 * Until now this was not noticeable, because the messages were in Bulgarian and hardcoded in it -
 * together with the phone and email, which had to be hunted down here too whenever they changed.
 * Now both come from here: one `JSON.parse` instead of nine data attributes and
 * zero hardcoded strings in the script.
 */
const MSG = JSON.stringify({
  sending: t.fSending,
  ok: t.fOk,
  notConfigured: t.fNotConfigured,
  rate: t.fRate,
  fail: t.fFail,
  callUs: t.fCallUs,
  orWrite: t.fOrWrite,
  offline: t.fOffline,
  phone: b.phone,
  phoneDisplay: b.phoneDisplay,
  email: b.email,
});
---
<form class="form panel" id="cform" novalidate data-msg={MSG}>
  {heading && <h2 class="fhead">{heading}</h2>}

  <div class="f2">
    <p class="fld">
      <label for="f-name">{t.fName} <span aria-hidden="true">*</span></label>
      <input id="f-name" name="name" type="text" required autocomplete="name" maxlength="80" />
      <span class="err" id="e-name" hidden>{t.eName}</span>
    </p>
    <p class="fld">
      <label for="f-phone">{t.fPhone} <span aria-hidden="true">*</span></label>
      <input id="f-phone" name="phone" type="tel" required autocomplete="tel" maxlength="30" inputmode="tel" />
      <span class="err" id="e-phone" hidden>{t.ePhone}</span>
    </p>
  </div>

  <div class="f2">
    <p class="fld">
      <label for="f-email">{t.fEmail}</label>
      <input id="f-email" name="email" type="email" autocomplete="email" maxlength="120" />
      <span class="err" id="e-email" hidden>{t.eEmail}</span>
    </p>
    <p class="fld">
      <label for="f-service">{t.fService}</label>
      <select id="f-service" name="service">
        <option value="">{t.fChoose}</option>
        {services.map((s) => <option value={s.name}>{s.name}</option>)}
        <option value={t.fOther}>{t.fOther}</option>
      </select>
    </p>
  </div>

  <p class="fld">
    <label for="f-car">{t.fCar}</label>
    <input id="f-car" name="car" type="text" maxlength="120" placeholder={t.fCarPlaceholder} />
    <span class="hint">{t.fCarHint}</span>
  </p>

  <p class="fld">
    <label for="f-msg">{t.fMessage}</label>
    <textarea id="f-msg" name="message" rows="4" maxlength="1500"></textarea>
  </p>

  <p class="fld check">
    <input id="f-gdpr" name="gdpr" type="checkbox" required />
    <label for="f-gdpr">
      {t.fGdpr}
      <a href={privacyHref}>{t.fGdprLink}</a>. <span aria-hidden="true">*</span>
    </label>
    <span class="err" id="e-gdpr" hidden>{t.eGdpr}</span>
  </p>

  {/* decoy for robots: a real person does not see it and does not fill it in */}
  <p class="trap" aria-hidden="true">
    <label for="f-web">{t.fTrap}</label>
    <input id="f-web" name="pdk_extra" type="text" tabindex="-1" autocomplete="off" />
  </p>

  <div class="fsub">
    <button type="submit" class="btn btn--go send" id="fsend">{t.fSend}</button>
    <span class="fnote">{t.fRequired}</span>
  </div>

  <p class="fmsg ok" id="fok" role="status" hidden></p>
  <p class="fmsg bad" id="fbad" role="alert" hidden></p>
</form>

<script>
// Validated both here and on the server (public/_worker.js). The button locks
// while the request runs, and the result is stated in words - not in silence.
const form = document.getElementById('cform') as HTMLFormElement | null;
if (form) {
  // the labels and contacts come from the page (data-msg) - see MSG above
  const m = JSON.parse(form.dataset.msg!) as Record<string, string>;
  const tel = `<a href="tel:${m.phone}">${m.phoneDisplay}</a>`;
  const mail = `<a href="mailto:${m.email}">${m.email}</a>`;
  const send = document.getElementById('fsend') as HTMLButtonElement;
  const ok = document.getElementById('fok')!;
  const bad = document.getElementById('fbad')!;
  const opened = Date.now();

  const field = (id: string) => document.getElementById('f-' + id) as HTMLInputElement;
  const errBox = (id: string) => document.getElementById('e-' + id)!;

  // A picker on another page sends the selection in the URL. We carry it into the field
  // so it does not have to be typed from memory - but with a length limit, because the value
  // comes from outside.
  const car = new URLSearchParams(location.search).get('car');
  if (car) {
    (field('car') as HTMLInputElement).value = car.slice(0, 120);
    history.replaceState(null, '', location.pathname + location.hash);
  }

  const setErr = (id: string, on: boolean) => {
    const el = field(id), box = errBox(id);
    box.hidden = !on;
    el.setAttribute('aria-invalid', String(on));
    if (on) el.setAttribute('aria-describedby', box.id); else el.removeAttribute('aria-describedby');
  };

  const checks: Record<string, () => boolean> = {
    name: () => field('name').value.trim().length >= 2,
    phone: () => field('phone').value.replace(/[^\d+]/g, '').length >= 6,
    email: () => { const v = field('email').value.trim(); return !v || /^[^@\s]+@[^@\s.]+\.[a-z]{2,}$/i.test(v); },
    gdpr: () => field('gdpr').checked,
  };

  // a single field is validated as soon as the person leaves it - not while typing
  for (const id of Object.keys(checks)) {
    field(id).addEventListener('blur', () => setErr(id, !checks[id]()));
    field(id).addEventListener('input', () => { if (!errBox(id).hidden) setErr(id, !checks[id]()); });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    ok.hidden = true; bad.hidden = true;

    let first: string | null = null;
    for (const id of Object.keys(checks)) {
      const good = checks[id]();
      setErr(id, !good);
      if (!good && !first) first = id;
    }
    if (first) { field(first).focus(); return; }

    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    data.elapsed = String(Date.now() - opened);
    data.page = location.pathname;   // which page the enquiry came from

    send.disabled = true;
    const label = send.textContent;
    send.textContent = m.sending;

    try {
      const r = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(data),
      });
      const j = await r.json().catch(() => ({}));
      if (r.ok && j.ok) {
        form.reset();
        ok.textContent = m.ok;
        ok.hidden = false;
        ok.scrollIntoView({ block: 'nearest' });
      } else {
        const why = j.code === 'not-configured' ? m.notConfigured
          : j.code === 'rate' ? m.rate
          : m.fail;
        bad.innerHTML = `${why}${m.callUs} ${tel} ${m.orWrite} ${mail}.`;
        bad.hidden = false;
      }
    } catch {
      bad.innerHTML = `${m.offline} ${tel}.`;
      bad.hidden = false;
    } finally {
      send.disabled = false;
      send.textContent = label;
    }
  });
}
</script>
