</style>

<script>
// ── hero: the numbers count up, the arrow sweeps, the frame moves with the pointer ──
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const STOCK = 190, TUNED = 220, MAXHP = 400;   // the example in the hero

const ease = (k: number) => 1 - Math.pow(1 - k, 3);
// In a hidden tab requestAnimationFrame stops — without this the numbers hang at zero,
// if the page is opened in the background. Then we simply show the final value.
const run = (ms: number, step: (k: number) => void) => {
  if (reduce || document.hidden) { step(1); return; }
  const t0 = performance.now();
  const tick = (now: number) => {
    if (document.hidden) { step(1); return; }
    const k = Math.min(1, (now - t0) / ms);
    step(ease(k));
    if (k < 1) requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
};

setTimeout(() => {
  document.querySelectorAll<HTMLElement>('[data-to]').forEach((el, i) => {
    const to = Number(el.dataset.to);
    setTimeout(() => run(1400, (e) => { el.textContent = '+' + Math.round(to * e); }), i * 130);
  });

  const g = document.getElementById('gval');
  if (g) g.style.width = (TUNED / MAXHP * 100) + '%';
  const num = document.getElementById('gnum');
  if (num) run(1800, (e) => { num.textContent = String(Math.round(STOCK + (TUNED - STOCK) * e)); });
}, 700);

// ── the video is attached AFTER the page is ready: it weighs ~400 KB and must not
//    compete with the fonts and the text for the first paint. Until it arrives,
//    the poster is shown. With data saver, a slow connection or reduced
//    motion it is not downloaded at all.
(() => {
  const v = document.getElementById('shot') as HTMLVideoElement | null;
  const hero = document.querySelector('.hero') as HTMLElement | null;
  if (!v || !hero) return;
  const c = (navigator as any).connection || {};
  const slow = c.saveData === true || /^(slow-)?2g$/.test(c.effectiveType || '') || c.effectiveType === '3g';
  if (!reduce && !slow) {                     // otherwise the poster stays
    const start = () => {
      for (const [src, type] of [['/img/pdk-hero2.webm', 'video/webm'], ['/img/pdk-hero2.mp4', 'video/mp4']]) {
        const s = document.createElement('source'); s.src = src; s.type = type; v.appendChild(s);
      }
      v.preload = 'auto'; v.load();
      v.play().catch(() => {});               // if the browser refuses — the poster stays
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2500 });
    else addEventListener('load', () => setTimeout(start, 400));
  }

  // ── THE HERO SLEEPS WHEN NOBODY IS LOOKING ──────────────────────────────────────
  // This also applies when there is no video: with `saveData` or a slow network the poster
  // stays, but the smoke and the live dot still spin, and exactly these machines have
  // the least power to spare for needless painting. That is why the observer is always attached.
  // The video loops, and the smoke and the live dot are infinite animations.
  // Until now all of this kept being decoded and painted while the person
  // was reading the catalogue three screens down or had gone to another tab: decoder,
  // compositing and `backdrop-filter` in the three cells, for a frame nobody
  // sees. `.rest` stops the animations with CSS, the video is paused directly.
  let inView = true, tabOn = !document.hidden;
  const settle = () => {
    const awake = inView && tabOn;
    hero.classList.toggle('rest', !awake);
    if (awake) { if (v.paused && v.currentSrc) v.play().catch(() => {}); }
    else if (!v.paused) v.pause();
  };
  new IntersectionObserver(([e]) => { inView = e.isIntersecting; settle(); }).observe(hero);
  document.addEventListener('visibilitychange', () => { tabOn = !document.hidden; settle(); });
})();

// depth: the frame shifts very slightly after the pointer
if (!reduce && matchMedia('(pointer:fine)').matches) {
  const hero = document.querySelector('.hero') as HTMLElement;
  const shot = document.getElementById('shot') as HTMLElement;
  // The mouse sends up to several hundred events a second, and each one touched
  // the transform of the full-screen video. Now it writes at most once per
  // frame: the last position is remembered and applied in the next frame.
  let px = 0, py = 0, queued = false;
  const apply = () => {
    queued = false;
    shot.style.setProperty('--px', px + 'px');
    shot.style.setProperty('--py', py + 'px');
  };
  hero.addEventListener('pointermove', (e) => {
    const r = hero.getBoundingClientRect();
    px = ((e.clientX - r.left) / r.width - .5) * -18;
    py = ((e.clientY - r.top) / r.height - .5) * -12;
    if (!queued) { queued = true; requestAnimationFrame(apply); }
  }, { passive: true });
  hero.addEventListener('pointerleave', () => {
    shot.style.setProperty('--px', '0px'); shot.style.setProperty('--py', '0px');
  });
}
</script>
