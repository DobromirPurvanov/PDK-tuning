---
/**
 * The analytics.
 *
 * The tag ID comes from the environment (`PUBLIC_GA_ID`) and is EMPTY in the mockup: demo
 * visits have no business in the client's property. Empty = this component emits
 * NOT A SINGLE line into the page.
 *
 * Google's script is neither preloaded nor "switched off" afterwards:
 * it loads ONLY after a "yes" from the banner (the `pdk:consent` event). On refusal nothing loads;
 * when an already-given consent is withdrawn the tag is shut off and the cookies are deleted.
 */
import { GA_ID } from '../config/site';
---
{GA_ID && (
  <script is:inline define:vars={{ id: GA_ID }}>
    (() => {
      let loaded = false;

      const load = () => {
        if (loaded) return;
        loaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        gtag('js', new Date());
        // Consent Mode v2: only statistics are allowed, no advertising
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'granted',
        });
        gtag('config', id, { anonymize_ip: true });
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
        document.head.appendChild(s);
      };

      const stop = () => {
        window['ga-disable-' + id] = true;
        // delete the cookies Google has already left behind
        for (const c of document.cookie.split(';')) {
          const name = c.split('=')[0].trim();
          if (/^(_ga|_gid|_gat)/.test(name)) {
            document.cookie = name + '=; Max-Age=0; path=/; domain=.' + location.hostname;
            document.cookie = name + '=; Max-Age=0; path=/';
          }
        }
      };

      // Defensive: a missing or malformed detail means "no consent" - when
      // in doubt NOTHING loads. Silently falling through to `load()` is exactly
      // the bug that would make the banner pointless.
      document.addEventListener('pdk:consent', (e) => {
        const ok = !!(e && e.detail && e.detail.analytics === true);
        ok ? load() : stop();
      });
    })();
  </script>
)}
