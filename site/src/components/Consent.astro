---
/**
 * Cookie consent.
 *
 * The rule is simple: until the person says "yes", NOTHING that tracks gets loaded.
 * That is why analytics is not in the page - it is attached only after
 * consent (see Analytics.astro, which listens for the `pdk:consent` event).
 *
 * THREE EQUAL CHOICES, not two. Supervisory authorities look at exactly this:
 * "accept all" and "necessary only" must cost the same effort -
 * one click, equally visible buttons. That is why refusal is NOT hidden text.
 * The third button opens the categories individually.
 *
 * NO CHECKBOX IS PRE-TICKED. The strictly necessary ones are ticked
 * and locked, because there is no service without them and they need no consent.
 *
 * The choice is kept in localStorage under `pdk-consent` with a VERSION NUMBER: if a new
 * provider appears tomorrow, bumping `V` asks again, instead of the old "yes"
 * covering something that was not described when it was given.
 */
import { LEGAL } from '../config/site';
import { LEGAL_EN, langOf } from '../i18n';
import { dict } from '../i18n/ui';

const lang = langOf(Astro.url.pathname);
const t = dict(lang);
const legal = lang === 'en' ? LEGAL_EN : LEGAL;

const privacy = legal[0].href;
const cookies = legal.find((l) => l.href.includes('cookie'))!;

/** categories, as shown in /cookie-policy/ too */
const CATS = [
  { key: 'necessary', name: t.ccNecessary, note: t.ccNecessaryNote, locked: true, on: true },
  { key: 'analytics', name: t.ccStats, note: t.ccStatsNote, locked: false, on: false },
  { key: 'marketing', name: t.ccMarketing, note: t.ccMarketingNote, locked: true, on: false },
] as const;
---
<div class="cc panel" id="cookieBar" role="dialog" aria-modal="true" aria-labelledby="ccTitle"
     aria-describedby="ccText" tabindex="-1" hidden>
  <div class="cc-in">
    <div class="cc-txt">
      <p class="cc-t" id="ccTitle">{t.ccTitle}</p>
      <p class="cc-p" id="ccText">
        {t.ccText} <a href={cookies.href}>{cookies.label}</a> {t.ccAnd}
        <a href={privacy}>{t.ccPrivacy}</a>.
      </p>
    </div>

    <!-- <!-- Categories: hidden until "Customize" is requested. Not a separate screen -
                  the banner expands in place so the context is not lost. -->
    <div class="cc-cats" id="ccCats" hidden>
      <fieldset>
        <legend class="cc-leg">{t.ccLegend}</legend>
        {CATS.map((c) => (
          <label class:list={['cc-cat', c.locked && 'locked']} for={`cc-${c.key}`}>
            <input
              type="checkbox"
              id={`cc-${c.key}`}
              data-cat={c.key}
              checked={c.on}
              disabled={c.locked}
              aria-describedby={`cc-n-${c.key}`}
            />
            <span class="cc-cat-b">
              <b>{c.name}{c.locked && <em>{c.on ? t.ccAlways : t.ccUnused}</em>}</b>
              <span class="cc-note" id={`cc-n-${c.key}`}>{c.note}</span>
            </span>
          </label>
        ))}
      </fieldset>
    </div>

    <div class="cc-btns">
      <button type="button" id="ccCustom" class="btn btn--ghost cc-b" aria-expanded="false" aria-controls="ccCats">{t.ccCustom}</button>
      <button type="button" id="ccNo" class="btn cc-b">{t.ccNo}</button>
      <button type="button" id="ccYes" class="btn btn--go cc-b">{t.ccYes}</button>
      <button type="button" id="ccSave" class="btn btn--go cc-b" hidden>{t.ccSave}</button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    'use strict';
    const KEY = 'pdk-consent';
    const V = 2;                       // bump on a new provider → asks again
    const bar = document.getElementById('cookieBar');
    if (!bar) return;

    const $ = (id) => document.getElementById(id);
    const cats = $('ccCats');
    const bCustom = $('ccCustom'), bNo = $('ccNo'), bYes = $('ccYes'), bSave = $('ccSave');
    if (!cats || !bCustom || !bNo || !bYes || !bSave) return;

    /** what we return to the listeners; marketing is reserved for the future, today it is always false */
    const shape = (analytics, marketing) => ({ analytics: !!analytics, marketing: !!marketing });

    const read = () => {
      try {
        const raw = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (!raw || typeof raw !== 'object') return null;
        if (raw.v !== V) return null;                 // old version = ask again
        if (typeof raw.analytics !== 'boolean') return null;
        return raw;
      } catch { return null; }
    };

    const tell = (c) => document.dispatchEvent(new CustomEvent('pdk:consent', { detail: c }));

    // ── focus trap ──────────────────────────────────────────────────────────
    // The dialog demands a decision, so Tab cycles inside it. The exit is NOT
    // blocked: Escape closes with a REFUSAL - the safe direction.
    let opener = null;
    const focusables = () =>
      [...bar.querySelectorAll('a[href],button:not([disabled]),input:not([disabled])')]
        .filter((el) => el.offsetParent !== null || el === document.activeElement);

    const onKey = (e) => {
      if (e.key === 'Escape') { e.preventDefault(); decide(false, false); return; }
      if (e.key !== 'Tab') return;
      const f = focusables();
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    };

    const open = (from) => {
      opener = from || null;
      bar.hidden = false;
      bar.addEventListener('keydown', onKey);
      // focus goes to the dialog, not to a button - the screen reader first reads what this is about
      bar.focus({ preventScroll: true });
    };

    const close = () => {
      bar.removeEventListener('keydown', onKey);
      bar.hidden = true;
      // focus returns to where it came from, otherwise it vanishes to the start of the document
      if (opener && document.contains(opener)) { try { opener.focus(); } catch {} }
      opener = null;
    };

    const decide = (analytics, marketing) => {
      const c = shape(analytics, marketing);
      try {
        localStorage.setItem(KEY, JSON.stringify({ v: V, ...c, ts: Date.now() }));
      } catch { /* "no storage" mode - the decision still holds for this page load */ }
      close();
      tell(c);
    };

    // ── the three choices ───────────────────────────────────────────────────
    bYes.addEventListener('click', () => decide(true, false));
    bNo.addEventListener('click', () => decide(false, false));

    bCustom.addEventListener('click', () => {
      const show = cats.hidden;
      cats.hidden = !show;
      bCustom.setAttribute('aria-expanded', String(show));
      // with the categories open, "Accept all" yields to "Save choice"
      bYes.hidden = show;
      bSave.hidden = !show;
      if (show) $('cc-analytics')?.focus();
    });

    bSave.addEventListener('click', () => {
      const a = $('cc-analytics');
      decide(!!(a && a.checked), false);
    });

    // ── startup ─────────────────────────────────────────────────────────────
    const saved = read();
    if (saved) tell(shape(saved.analytics, saved.marketing));
    else open(null);

    // the link in the bottom row reopens the banner so the decision can be changed
    document.getElementById('cookieOpen')?.addEventListener('click', (e) => {
      const s = read();
      const a = $('cc-analytics');
      if (a) a.checked = !!(s && s.analytics);      // show the CURRENT choice, not a reset one
      open(e.currentTarget);
    });
  })();
</script>

<style>
.cc{position:fixed;left:12px;right:12px;bottom:12px;z-index:var(--z-modal);
  box-shadow:var(--shadow);max-height:calc(100vh - 24px);overflow-y:auto}
@media(min-width:900px){.cc{left:auto;right:24px;bottom:24px;max-width:520px;max-height:calc(100vh - 48px)}}
.cc[hidden]{display:none}
.cc-in{padding:22px 24px;display:flex;flex-direction:column;gap:18px}
.cc-t{margin:0 0 8px;font:700 18px/1 var(--head);text-transform:uppercase;letter-spacing:.01em}
.cc-p{margin:0;font:400 var(--fz-xs)/1.6 var(--body);color:var(--ink-3)}
.cc-p a{color:var(--lime);border-bottom:1px solid var(--lime-line)}

/* ── categories ──────────────────────────────────────────────────────────── */
.cc-cats fieldset{margin:0;padding:0;border:0}
.cc-leg{padding:0 0 12px;font:400 var(--fz-lab)/1 var(--mono);letter-spacing:.2em;
  text-transform:uppercase;color:var(--ink-4)}
.cc-cat{display:grid;grid-template-columns:auto 1fr;gap:0 12px;align-items:start;
  padding:12px 0;border-top:1px solid var(--line);cursor:pointer}
.cc-cat.locked{cursor:default}
.cc-cat input{width:24px;height:24px;margin:1px 0 0;accent-color:var(--lime);cursor:pointer}
.cc-cat.locked input{cursor:not-allowed;opacity:.55}
.cc-cat-b b{display:flex;flex-wrap:wrap;align-items:baseline;gap:0 10px;
  font:400 var(--fz-s)/1.4 var(--body);color:var(--white)}
.cc-cat-b b em{font-style:normal;font:400 var(--fz-lab)/1 var(--mono);letter-spacing:.18em;
  text-transform:uppercase;color:var(--ink-5)}
.cc-note{display:block;margin-top:5px;font:400 var(--fz-2xs)/1.55 var(--body);color:var(--ink-4)}

/* ── buttons: refusal is NOT smaller than acceptance ──────────────────────── */
.cc-btns{display:flex;flex-wrap:wrap;gap:10px}
/* look comes from `.btn`; here is only how they split the width */
.cc-b{flex:1 1 auto;--btn-h:48px;--btn-py:14px;--btn-px:18px}
.cc-b[hidden]{display:none}
.cc-b.btn--ghost{flex:0 1 auto}
@media(max-width:419px){.cc-b{flex:1 1 100%}}
</style>
