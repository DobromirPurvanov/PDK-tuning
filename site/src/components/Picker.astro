---
/**
 * THE PICKER — make → model → year → engine, live from the database.
 *
 * It used to be embedded in the home page. It was moved out here because now the
 * hundred brand pages use it too: a copy of 150 lines of script on each of them is
 * the way to end up with three different versions one day.
 *
 * Nothing from the catalogue is stored here. Every level is one request to
 * `/api/live/*` in public/_worker.js, which reads the old site at the moment of
 * the request. The cache lives only in the memory of the open page.
 *
 * WATCH OUT FOR CLASS NAMES. The styles are `is:global`, because the
 * script creates the buttons with JS and Astro's scoping does not catch them. Once
 * the progress bar was called `bar` — just like the bar at the top — and inherited
 * `position:fixed`, so it lay across the whole screen. That is why it is `pline`.
 */
import { BUSINESS } from '../config/site';
import { langOf } from '../i18n';

interface Props {
  /** heading above the picker */
  heading?: string;
  sub?: string;
  /** brand to preselect on load (the brand pages) */
  brand?: string;
  /** where the "Book an appointment" button goes when the page has no form */
  formHref?: string;
}

/**
 * THE PICKER'S LABELS.
 *
 * Kept here, not in `i18n/ui.ts`, because they are its own and only its own — twenty-
 * five lines that no other component reads. In the shared dictionary they would
 * double its length and make it harder to review exactly when
 * checking whether a translation is missing.
 *
 * The script below receives them as ONE data attribute: `<script>` in Astro is
 * bundled separately and cannot see the variables above. The same trick as in
 * `ContactForm.astro`.
 */
const L = {
  bg: {
    heading: 'Изберете своя автомобил',
    sub: 'Четири стъпки до реалните числа за вашия двигател.',
    clear: 'Изчистване на избора',
    step: 'завършени',
    brand: 'Марка', model: 'Модел', year: 'Година', engine: 'Двигател',
    searchBrand: 'Търсене на марка…',
    loadingDb: 'Тегли от базата…', loading: 'Тегли…',
    pickBrand: 'Изберете марка', pickModel: 'Изберете модел', pickYear: 'Изберете година',
    allYears: 'Всички години',
    noBrand: 'Няма такава марка', noAnswer: 'Старият сайт не отговаря',
    diff: 'Разликата', hp: 'к.с.', power: 'Мощност', torque: 'Момент',
    noData: 'няма данни',
    note: 'Числата са от базата. Точната стойност за вашата кола се мери на стенда.',
    noteEmpty: 'За този двигател базата няма числа. Обадете се и ще проверим.',
    noteFail: 'Базата не отговаря. Обадете се, числата ги имаме.',
    help: 'Нужна ли ви е помощ? ↗', back: 'Назад', next: 'Запазете час',
  },
  en: {
    heading: 'Find your car',
    sub: 'Four steps to the real figures for your engine.',
    clear: 'Clear the selection',
    step: 'complete',
    brand: 'Make', model: 'Model', year: 'Year', engine: 'Engine',
    searchBrand: 'Search for a make…',
    loadingDb: 'Loading from the database…', loading: 'Loading…',
    pickBrand: 'Choose a make', pickModel: 'Choose a model', pickYear: 'Choose a year',
    allYears: 'All years',
    noBrand: 'No such make', noAnswer: 'The catalogue is not responding',
    diff: 'The difference', hp: 'hp', power: 'Power', torque: 'Torque',
    noData: 'no data',
    note: 'Figures come from the database. The exact value for your car is measured on the dyno.',
    noteEmpty: 'The database has no figures for this engine. Call us and we will check.',
    noteFail: 'The database is not responding. Call us, we have the figures.',
    help: 'Need help? ↗', back: 'Back', next: 'Book a slot',
  },
} as const;

const lang = langOf(Astro.url.pathname);
const t = L[lang];

const {
  heading = t.heading,
  sub = t.sub,
  brand = '',
  formHref = lang === 'en' ? '/en/contact/' : '/kontakti/',
} = Astro.props;
---

<section class="pick">
  <div class="panel pick-panel" id="picker" data-brand={brand} data-form={formHref}
       data-lab={JSON.stringify(t)}>
    <div class="ph">
      <div class="line">
        <div>
          <h2>{heading}</h2>
          <p>{sub}</p>
        </div>
        <button class="x" type="button" id="pclear" aria-label={t.clear}>✕</button>
      </div>
      <div class="prog"><span class="pline"><i id="pbar"></i></span><span id="pstep">1 / 4 {t.step}</span></div>
    </div>

    <div class="cols">
      <div class="col">
        <b id="lab-brand">{t.brand}</b>
        <input id="bq" class="q" type="search" placeholder={t.searchBrand} autocomplete="off" aria-label={t.searchBrand} />
        <ul id="c1" aria-labelledby="lab-brand"><li class="empty">{t.loadingDb}</li></ul>
      </div>
      <div class="col"><b id="lab-model">{t.model}</b><ul id="c2" aria-labelledby="lab-model"><li class="empty">{t.pickBrand}</li></ul></div>
      <div class="col"><b id="lab-year">{t.year}</b><ul id="c3" aria-labelledby="lab-year"><li class="empty">{t.pickModel}</li></ul></div>
      <div class="col">
        <b id="lab-engine">{t.engine}</b>
        <ul id="c4" aria-labelledby="lab-engine"><li class="empty">{t.pickYear}</li></ul>
      </div>
    </div>

    {/*
      THE RESULT SPANS THE FULL WIDTH, not the fourth column.
      There it sat squeezed to 250px and covered the list of engines — exactly at
      the moment the person finally sees their number. Now it is a bar under the
      columns: the big difference on the left, the two quantities as bars on the right.

      The bars are taken from Line graph on 21st (@motiondotdev, id 24687) —
      they are drawn when shown and carry a compact percentage difference. The curve
      FROM THERE was deliberately not carried over: the database gives two numbers (max power
      before and after), and a curve drawn between them looks like a dyno
      measurement, which it is not.
    */}
    <div class="res" id="res" role="status" aria-live="polite">
      <div class="res-l">
        <p class="res-k">{t.diff}</p>
        <div class="res-big"><b id="rhp">+0</b><span>{t.hp}</span></div>
        <p class="res-car" id="rcar"></p>
      </div>

      <div class="res-r">
        <div class="res-row" id="row-hp">
          <span class="res-lab">{t.power}</span>
          <span class="res-a" id="rp0">—</span>
          <span class="res-bar"><i></i></span>
          <span class="res-b" id="rp1">—</span>
          <span class="res-d" id="rpd"></span>
        </div>
        <div class="res-row" id="row-nm">
          <span class="res-lab">{t.torque}</span>
          <span class="res-a" id="rn0">—</span>
          <span class="res-bar"><i></i></span>
          <span class="res-b" id="rn1">—</span>
          <span class="res-d" id="rnd"></span>
        </div>
        <p class="res-note" id="rnote">{t.note}</p>
      </div>
    </div>

    <div class="pf">
      <a class="help" href={`tel:${BUSINESS.phone}`}>{t.help}</a>
      <div class="btns">
        <button id="pback" type="button" disabled>{t.back}</button>
        <button class="go" id="pnext" type="button">{t.next}</button>
      </div>
    </div>
  </div>
</section>

<script>
// Every level is ONE request to the live database via /api/live/* (see public/_worker.js).
type Item = { slug: string; label: string; right?: string; value?: any; key?: string };

const panel = document.getElementById('picker');
if (panel) {
  // the labels come from the page (data-lab) — see `L` at the top of the file
  const L = JSON.parse(panel.dataset.lab!) as Record<string, string>;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Deliberately NOT `!`: the same script runs on pages without the form and without
  // the counters in the hero. A missing node means "this page does not have that", not an error.
  const $ = (id: string) => document.getElementById(id);
  const need = (id: string) => document.getElementById(id)!;
  const cols = [need('c1'), need('c2'), need('c3'), need('c4')];
  const state: Record<string, any> = { b: null, m: null, y: null, e: null };
  const mem = new Map<string, any>();

  async function live(path: string) {
    if (mem.has(path)) return mem.get(path);
    const r = await fetch('/api/live/' + path);
    const j = await r.json();
    if (!r.ok) throw new Error(j.error || r.status);
    mem.set(path, j.data);
    return j.data;
  }

  const note = (ul: HTMLElement, txt: string) => {
    ul.replaceChildren();
    const li = document.createElement('li');
    li.className = 'empty';
    li.textContent = txt;
    ul.appendChild(li);
  };

  function fill(ul: HTMLElement, items: Item[], onPick: (v: any) => void) {
    ul.innerHTML = '';
    const frag = document.createDocumentFragment();
    for (const it of items) {
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      const name = document.createElement('span');
      name.textContent = it.label;
      btn.appendChild(name);
      if (it.right) { const em = document.createElement('em'); em.textContent = it.right; btn.appendChild(em); }
      btn.onclick = (ev) => {
        ev.preventDefault();
        ul.querySelectorAll('button').forEach((x) => x.classList.remove('on'));
        btn.classList.add('on');
        onPick(it.value ?? it);
      };
      li.appendChild(btn); frag.appendChild(li);
    }
    ul.appendChild(frag);
  }

  const cols4 = panel.querySelector('.cols') as HTMLElement;
  const step = (n: number) => {
    cols4.dataset.step = String(n);   // on a narrow screen only this column is visible
    need('pbar').style.width = (n / 4 * 100) + '%';
    need('pstep').textContent = `${n} / 4 ${L.step}`;
    (need('pback') as HTMLButtonElement).disabled = n <= 1;
  };
  const reset = (from: number) => {
    const hints = ['', L.pickBrand, L.pickModel, L.pickYear];
    for (let i = from; i < 4; i++) note(cols[i], hints[i]);
    need('res').classList.remove('on');
  };
  // "316D 116hp" → 116; we show the power on the RIGHT in the column.
  // The unit is the Bulgarian "hp" abbreviation, not Latin "hp" — below it, in the result, it says the same, and
  // two different units for the same number read as two different numbers.
  // If the power CANNOT be derived from the name (it sits before the engine code, as in
  // "1.4 Multi-Air - 140 hp (8GMK.Fx)"), the right column is left empty —
  // otherwise the same number is read twice on one row.
  const hpOf = (label: string) => {
    if (/\d\s*hp/i.test(stripHp(label))) return '';
    const m = label.match(/(\d+)\s*hp/i);
    return m ? m[1] + ' ' + L.hp : '';
  };
  // …and we REMOVE it from the name itself, otherwise the row comes out as "3.0i Bi-turbo 340hp   340 hp".
  // The old database appends the power at the end, sometimes with a space, sometimes without. It is cut only at
  // the END — "320d 163hp" yes, "116d 1.6 116hp xDrive" no.
  // The second cleanup is for the dangling separator: "2.0 Tfsi - 235hp" used to leave
  // "2.0 Tfsi -" with a dash that leads nowhere.
  // After the power the database sometimes appends the displacement too: "318D 136hp (1995cc)". It is
  // allowed AFTER the number, because it is a recognisable fragment and not part of the name of
  // the version — otherwise the row came out as "318D 136hp (1995cc)   136 hp (BG unit)".
  const stripHp = (label: string) =>
    label
      .replace(/\s*\d+\s*hp(\s*\(\s*\d+\s*(?:cc|ccm)\s*\))?\s*$/i, '')
      .replace(/\s*[-–—·|,]\s*$/, '').trim() || label;

  /** One bar: grey is the factory value, green is the addition. The length of
   *  the green is the SHARE of the addition in the final number — not arbitrary. */
  function bar(rowId: string, a0: string, b0: string, d0: string,
               pair: number[] | null, unit: string, delay: number) {
    const row = need(rowId);
    const fill = row.querySelector('.res-bar i') as HTMLElement;
    if (!pair) {
      row.classList.add('nodata');
      need(a0).textContent = '—'; need(b0).textContent = L.noData;
      need(d0).textContent = ''; fill.style.width = '0';
      return;
    }
    row.classList.remove('nodata');
    need(a0).textContent = String(pair[0]);
    need(b0).innerHTML = `<b>${pair[1]}</b> ${unit}`;
    // the compact percentage difference is the idea of Line graph from 21st
    need(d0).textContent = '+' + Math.round(((pair[1] - pair[0]) / pair[0]) * 100) + '%';
    // zero → width in the next frame, so the transition starts; the delay lines up
    // the two bars one after the other, instead of jumping together
    fill.style.transition = 'none';
    fill.style.width = '0';
    requestAnimationFrame(() => {
      fill.style.transition = '';
      fill.style.transitionDelay = calm ? '0s' : delay + 's';
      fill.style.width = Math.round(((pair[1] - pair[0]) / pair[1]) * 100) + '%';
    });
  }

  async function pickEngine(e: Item) {
    state.e = e; step(4);
    need('rhp').textContent = '…';
    // Every part is a separate non-breaking chunk — otherwise "2010 → 2011" used to break into
    // two and the year dangled on the next line without its arrow.
    const car = need('rcar');
    car.replaceChildren();
    for (const part of [state.b?.label, state.m?.label, state.y?.label, stripHp(e.label)].filter(Boolean)) {
      const s = document.createElement('span');
      s.textContent = part;
      car.appendChild(s);
    }
    need('res').classList.add('on');
    try {
      const r = await live(`result/${state.b.slug}/${state.m.slug}/${state.y.slug}/${e.slug}`);
      // In the old database there are engines with empty cells — then "+-140" came out and
      // "140 → 0" with the unit. Better empty than an invented number.
      const real = (p: number[] | null) => (p && p[0] > 0 && p[1] > p[0] ? p : null);
      const hp = real(r.hp), nm = real(r.nm);
      need('rhp').textContent = hp ? '+' + (hp[1] - hp[0]) : '—';
      bar('row-hp', 'rp0', 'rp1', 'rpd', hp, L.hp, 0);
      bar('row-nm', 'rn0', 'rn1', 'rnd', nm, 'Nm', 0.18);
      need('rnote').textContent = hp
        ? L.note
        : L.noteEmpty;
    } catch {
      need('rhp').textContent = '—';
      bar('row-hp', 'rp0', 'rp1', 'rpd', null, '', 0);
      bar('row-nm', 'rn0', 'rn1', 'rnd', null, '', 0);
      need('rnote').textContent = L.noteFail;
    }
  }

  async function pickYear(y: Item) {
    state.y = y; reset(3); step(3);
    note(cols[3], L.loading);
    try {
      const list = await live(`engines/${state.b.slug}/${state.m.slug}/${y.slug}`);
      // `value` keeps the WHOLE name — it goes into the enquiry and the "Car" field;
      // the trimmed one is only for the screen, so the power is not repeated.
      fill(cols[3], list.map((e: Item) => ({
        ...e, label: stripHp(e.label), right: hpOf(e.label), value: e,
      })), pickEngine);
    } catch (err: any) { note(cols[3], String(err.message)); }
  }

  async function pickModel(m: Item) {
    state.m = m; reset(2); step(2);
    note(cols[2], L.loading);
    try {
      // The old database writes the generation "without years" as `All` — an English word
      // in the middle of a Bulgarian list. The slug stays as it is (it goes into the request),
      // only the visible text is changed.
      const years = await live(`years/${state.b.slug}/${m.slug}`);
      fill(cols[2], years.map((y: Item) =>
        /^all$/i.test(y.label) ? { ...y, label: L.allYears } : y), pickYear);
    } catch (err: any) { note(cols[2], String(err.message)); }
  }

  async function pickBrand(b: Item) {
    state.b = b; reset(1); step(1);
    note(cols[1], L.loading);
    try {
      fill(cols[1], await live(`models/${b.slug}`), pickModel);
    } catch (err: any) { note(cols[1], String(err.message)); }
  }

  let brandItems: Item[] = [];
  (async () => {
    try {
      const list = await live('brands');
      brandItems = list.map((b: Item) => ({ ...b, key: b.label.toLowerCase() }));
      fill(cols[0], brandItems, pickBrand);
      // the counters exist only on the home page
      const n = String(list.length);
      const hb = $('hBrands'); if (hb) hb.textContent = n;
      const wc = $('wCount'); if (wc) wc.textContent = n;

      // On a brand page the picker starts already selected. If the live database does not
      // know this slug, we simply stay on the first step — better than
      // staying silent with an empty column.
      const want = panel.dataset.brand;
      if (want) {
        const hit = brandItems.find((b) => b.slug === want);
        if (hit) {
          const btn = Array.from(cols[0].querySelectorAll('button'))
            .find((x) => x.querySelector('span')?.textContent === hit.label);
          btn?.classList.add('on');
          btn?.scrollIntoView({ block: 'nearest' });
          pickBrand(hit);
        }
      }
    } catch {
      note(cols[0], L.noAnswer);
      const hb = $('hBrands'); if (hb) hb.textContent = '—';
    }
  })();
  step(1);

  need('bq').addEventListener('input', (ev) => {
    const q = (ev.target as HTMLInputElement).value.trim().toLowerCase();
    const hit = q ? brandItems.filter((b) => b.key!.includes(q)) : brandItems;
    if (!hit.length) { note(cols[0], L.noBrand); return; }
    fill(cols[0], hit, pickBrand);
  });

  need('pback').onclick = () => {
    if (state.e) { state.e = null; need('res').classList.remove('on'); step(3); }
    else if (state.y) { state.y = null; reset(3); step(2); }
    else if (state.m) { state.m = null; reset(2); step(1); }
  };

  // "✕" clears the selection and returns the picker to the first step
  need('pclear').onclick = () => {
    state.b = state.m = state.y = state.e = null;
    (need('bq') as HTMLInputElement).value = '';
    fill(cols[0], brandItems, pickBrand);
    reset(1); step(1);
  };

  // "Book appointment" carries the selection into the enquiry. On the home page and on /kontakti/
  // the form is on the same page; everywhere else we go to it with the car
  // in the URL, so it does not have to be typed by hand.
  need('pnext').onclick = () => {
    const parts = [state.b?.label, state.m?.label, state.y?.label, state.e?.label].filter(Boolean);
    const car = $('f-car') as HTMLInputElement | null;
    if (car) {
      if (parts.length) car.value = parts.join(' · ');
      document.getElementById('contact')?.scrollIntoView({ behavior: calm ? 'auto' : 'smooth' });
      setTimeout(() => ($('f-name') as HTMLInputElement | null)?.focus(), calm ? 0 : 500);
      return;
    }
    const to = panel.dataset.form || '/kontakti/';
    location.href = parts.length ? `${to}?car=${encodeURIComponent(parts.join(' · '))}` : to;
  };
}
</script>

<style is:global>
/* ── the picker — from Multi-Step Form (21st, id 8281) ─────────────────────── */
.pick{padding:0 var(--gut) 104px}
/* the background, border and radius come from `.panel` in `ui.css`; HERE there used to be a second
   class named `panel` — two rules for one name in global scope are a trap
   that has already cost us two rounds of looking at the wrong element. */
.pick-panel{max-width:var(--w-panel);margin:0 auto;overflow:hidden}
.ph{padding:30px 34px 26px;border-bottom:1px solid var(--line)}
.ph .line{display:flex;align-items:flex-start;justify-content:space-between;gap:20px}
.ph h2{margin:0;font:700 clamp(24px,2.6vw,32px)/1.05 var(--head);text-transform:uppercase;letter-spacing:-.01em}
.ph p{margin:8px 0 0;font:400 var(--fz-xs)/1.6 var(--mono);color:var(--ink-4)}
.x{width:38px;height:38px;border-radius:var(--r-s);border:1px solid var(--line);background:none;cursor:pointer;
  display:grid;place-items:center;flex:0 0 auto;color:var(--ink-4);transition:var(--t-fast)}
.x:hover{border-color:var(--line-strong);color:var(--white)}
.prog{display:flex;align-items:center;gap:16px;margin-top:22px}
.prog .pline{flex:1;height:5px;border-radius:var(--r-pill);background:var(--tint-2);overflow:hidden}
.prog .pline i{display:block;height:100%;width:25%;border-radius:var(--r-pill);background:var(--lime);transition:width var(--t) ease}
.prog span{font:400 var(--fz-btn)/1 var(--mono);color:var(--ink-4);white-space:nowrap}
.cols{display:grid;grid-template-columns:1fr;min-height:308px}
@media(min-width:760px){.cols{grid-template-columns:repeat(4,1fr)}}
.col{border-right:1px solid var(--line);display:flex;flex-direction:column;min-width:0}
.col:last-child{border-right:0}
@media(max-width:759px){.col{border-right:0;border-bottom:1px solid var(--line)}}
.col > b{display:block;padding:16px 18px 12px;font:400 var(--fz-lab)/1 var(--mono);letter-spacing:.24em;
  text-transform:uppercase;color:var(--ink-4);font-weight:400}
.col .q{margin:0 14px 8px;padding:11px;min-height:44px;background:var(--tint-2);
  border:1px solid var(--line);border-radius:var(--r-s);color:var(--white);font:400 var(--fz-2xs)/1 var(--mono);
  outline:none;min-width:0}
.col .q::placeholder{color:var(--ink-4)}
.col .q:focus{border-color:var(--lime)}
.col ul{margin:0;padding:0 0 12px;list-style:none;overflow-y:auto;max-height:246px;scrollbar-width:thin}
.col li{margin:0}
.col button{display:flex;width:100%;align-items:center;justify-content:space-between;gap:10px;
  padding:11px 18px;min-height:44px;background:none;border:0;text-align:left;cursor:pointer;
  font:400 var(--fz-xs)/1.35 var(--body);color:var(--ink-3);transition:var(--t-fast)}
.col button:hover{color:var(--white);background:var(--tint-2)}
.col button.on{color:var(--lime);background:var(--lime-dim);box-shadow:inset 2px 0 0 var(--lime)}
.col button em{font-style:normal;font-family:var(--mono);font-size:var(--fz-btn);color:var(--ink-4)}
.col .empty{padding:16px 18px;font:400 var(--fz-btn)/1.6 var(--mono);color:var(--ink-4)}

/* ── the result: a bar across the full width under the columns ────────────────── */
.res{display:none;border-top:1px solid var(--line);
  background:linear-gradient(180deg,var(--lime-dim),transparent 70%)}
.res.on{display:grid;grid-template-columns:1fr;gap:0}
@media(min-width:760px){.res.on{grid-template-columns:238px 1fr}}

.res-l{padding:24px 30px;border-bottom:1px solid var(--line)}
@media(min-width:760px){.res-l{border-bottom:0;border-right:1px solid var(--line)}}
.res-k{margin:0;font:400 var(--fz-lab)/1 var(--mono);letter-spacing:.24em;text-transform:uppercase;color:var(--ink-4)}
.res-big{display:flex;align-items:baseline;gap:8px;margin-top:12px}
.res-big b{font:700 clamp(44px,6vw,58px)/1 var(--head);color:var(--lime);font-variant-numeric:tabular-nums}
.res-big span{font:400 var(--fz-lab)/1 var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--ink-4)}
