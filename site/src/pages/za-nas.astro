---
/**
 * „КОИ СМЕ НИЕ?“ — заглавие от собствения им речник.
 *
 * ВНИМАНИЕ: тук стоят полета, които ЧАКАТ клиента (ЕИК, точният адрес, годината
 * на започване). Те са в рамка `p-fill`, за да се вижда с очи, че не са
 * попълнени — а не да минат за факт. Оценката от Google НЕ се маркира като
 * `aggregateRating`: самооценка без видими отзиви е против правилата.
 */
import Page from '../layouts/Page.astro';
import { crumbSchema, bizRef } from '../lib/seo';
import { BUSINESS as b } from '../config/site';
import marks from '../data/marks.json';
import { SERVICES } from '../data/services';

const site = Astro.site!.href.replace(/\/$/, '');
const crumbs = [{ href: '/za-nas/', label: 'За нас' }];
const schema = [bizRef(site), crumbSchema(site, [{ href: '/', label: 'Начало' }, ...crumbs])];

const numbers = [
  { n: String(b.yearsExperience), l: 'години с блокове' },
  { n: String((marks as unknown[]).length), l: 'марки в базата' },
  { n: String(SERVICES.length), l: 'услуги' },
  { n: String(b.countries), l: 'държави с партньори' },
];
---
<Page
  title="Кои сме ние: PDK Tuning, чип тунинг във Варна"
  description="Сервиз във Варна със собствен стенд за измерване на мощност и 15 години опит със софтуер за управляващи блокове. Работим с крайни клиенти и партньорски сервизи."
  kicker="Кои сме ние"
  heading="За нас"
  lead="PDK Tuning е сервиз във Варна със собствен стенд за измерване на мощност. Имаме 15 години опит в работата със софтуер за управляващи блокове. При нас идват както собственици на автомобили, така и сервизи, с които работим по софтуерни настройки."
  crumbs={crumbs}
  schema={schema}
>
  <div class="p-wrap">
    <section class="p-sec">
      <div class="nums">
        {numbers.map((x) => (
          <div class="num">
            <b>{x.n}</b>
            <span>{x.l}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="p-sec">
      <div class="p-split">
        <div class="p-prose">
          <h2>С какво се занимаваме</h2>
          <p>
            Работим със софтуер за управляващи блокове на автомобили. Услугите ни включват чип
            тунинг, Stage 2, настройки на автоматични скоростни кутии и възстановяване на блокове
            след неуспешен запис.
          </p>
          <p>
            Работим както с крайни клиенти, така и с партньорски сервизи, които ни изпращат
            софтуер за обработка.
          </p>

          <h2>Измерване на стенд</h2>
          <p>
            Разполагаме със собствен стенд за измерване на мощност и въртящ момент. Когато
            измерването е част от услугата, сравняваме резултатите преди и след настройката на
            един и същ стенд и ви показваме графиките.
          </p>

          <h2>Кога не препоръчваме настройка</h2>
          <p>
            Не всяка промяна има смисъл за всеки автомобил. Ако установим технически проблем,
            първо препоръчваме той да бъде отстранен. При двигатели с ограничен потенциал
            обясняваме какъв резултат може да се очаква, за да прецените дали услугата си струва
            за вас.
          </p>
          <p>
            Ако автомобилът е в гаранция, обсъждаме и възможното отражение на софтуерната промяна
            върху нея, преди да започнем работа.
          </p>

          <h2>За партньорските сервизи</h2>
          <p>
            Сервизите, с които работим, могат да изпращат файлове и да получават готовите
            настройки през отделен партньорски портал. Достъпът се предоставя индивидуално.
            Повече информация има на страницата <a href="/za-dileri/">За дилъри и сервизи</a>.
          </p>
        </div>

        <aside class="p-facts panel">
          <h2>Фирмата</h2>
          <dl>
            <dt>Юридическо лице</dt>
            <dd>{b.legalName}</dd>
            {/* няма стойност → двойката отпада, вместо да стои празна рамка */}
            {b.eik && <><dt>ЕИК</dt><dd>{b.eik}</dd></>}
            {b.vat && <><dt>ДДС номер</dt><dd>{b.vat}</dd></>}
            <dt>Сервиз</dt>
            <dd>{b.address.street}, {b.address.city}</dd>
            <dt>Телефон</dt>
            <dd><a href={`tel:${b.phone}`} style="color:inherit;border-bottom:1px solid var(--line-soft)">{b.phoneDisplay}</a></dd>
            <dt>Имейл</dt>
            <dd><a href={`mailto:${b.email}`} style="color:inherit;border-bottom:1px solid var(--line-soft)">{b.email}</a></dd>
          </dl>
          {/*
            Седалището в правните страници СЕ СТРОИ от `business.address` —
            вж. `legalAddress` в src/config/site.ts и `_legalAddress_todo`
            в src/data/business.json.
          */}
        </aside>
      </div>
    </section>

    <section class="p-sec">
      <h2>Свържете се с нас</h2>
      <div class="p-prose">
        <p>
          {b.legalName}<br />
          Телефон: <a href={`tel:${b.phone}`}>{b.phoneDisplay}</a><br />
          Имейл: <a href={`mailto:${b.email}`}>{b.email}</a>
        </p>
        <p>
          Работим с клиенти от Варна и с партньорски сервизи от други населени места. За
          посещение, работно време и запитвания вижте страницата <a href="/kontakti/">Контакти</a>.
        </p>
        <p>
          <a href={b.social.maps} target="_blank" rel="noopener noreferrer">Вижте ни в Google Карти →</a>
        </p>
      </div>
    </section>
  </div>
</Page>

<style is:global>
.nums{display:grid;gap:14px;grid-template-columns:1fr 1fr}
@media(min-width:760px){.nums{grid-template-columns:repeat(4,1fr);gap:18px}}
.num{padding:26px 24px;border:1px solid var(--line);border-radius:var(--r-m);background:var(--surface)}
.num b{display:block;font:700 clamp(34px,4.4vw,52px)/1 var(--head);color:var(--lime);
  letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.num span{display:block;margin-top:10px;font:400 var(--fz-lab)/1.5 var(--mono);letter-spacing:.18em;
  text-transform:uppercase;color:var(--ink-4)}
</style>
