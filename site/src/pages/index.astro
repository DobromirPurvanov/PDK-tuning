</style>

<script>
// ── хирото: числата се навъртат, стрелката мете, кадърът се движи с показалеца ──
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const STOCK = 190, TUNED = 220, MAXHP = 400;   // примерът в хироту

const ease = (k: number) => 1 - Math.pow(1 - k, 3);
// В скрит таб requestAnimationFrame спира — без това числата увисват на нула,
// ако страницата е отворена на заден план. Тогава просто показваме крайното.
const run = (ms: number, step: (k: number) => void) => {
  if (reduce || document.hidden) { step(1); return; }
  const t0 = performance.now();
  const tick = (now: number) => {
    if (document.hidden) { step(1); return; }
    const k = Math.min(1, (now - t0) / ms);
    step(ease(k));
    if (k < 1) requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
};

setTimeout(() => {
  document.querySelectorAll<HTMLElement>('[data-to]').forEach((el, i) => {
    const to = Number(el.dataset.to);
    setTimeout(() => run(1400, (e) => { el.textContent = '+' + Math.round(to * e); }), i * 130);
  });

  const g = document.getElementById('gval');
  if (g) g.style.width = (TUNED / MAXHP * 100) + '%';
  const num = document.getElementById('gnum');
  if (num) run(1800, (e) => { num.textContent = String(Math.round(STOCK + (TUNED - STOCK) * e)); });
}, 700);

// ── видеото се закача СЛЕД като страницата е готова: то тежи ~400 KB и не бива
//    да се състезава с шрифтовете и текста за първото рисуване. Докато го няма,
//    се вижда плакатът. При пестене на данни, бавна връзка или изключено
//    движение изобщо не се тегли.
(() => {
  const v = document.getElementById('shot') as HTMLVideoElement | null;
  const hero = document.querySelector('.hero') as HTMLElement | null;
  if (!v || !hero) return;
  const c = (navigator as any).connection || {};
  const slow = c.saveData === true || /^(slow-)?2g$/.test(c.effectiveType || '') || c.effectiveType === '3g';
  if (!reduce && !slow) {                     // иначе остава плакатът
    const start = () => {
      for (const [src, type] of [['/img/pdk-hero2.webm', 'video/webm'], ['/img/pdk-hero2.mp4', 'video/mp4']]) {
        const s = document.createElement('source'); s.src = src; s.type = type; v.appendChild(s);
      }
      v.preload = 'auto'; v.load();
      v.play().catch(() => {});               // ако браузърът откаже — плакатът остава
    };
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2500 });
    else addEventListener('load', () => setTimeout(start, 400));
  }

  // ── ХИРОТО СПИ, КОГАТО НЕ СЕ ГЛЕДА ──────────────────────────────────────
  // Важи и когато видеото го няма: при `saveData` или бавна мрежа плакатът
  // стои, но димът и живата точка пак се въртят, а точно тези машини имат
  // най-малко ток за излишно рисуване. Затова наблюдателят се закача винаги.
  // Видеото върви в примка, а димът и живата точка са безкрайни анимации.
  // Дотук всичко това продължаваше да се декодира и рисува, докато човекът
  // чете каталога три екрана по-надолу или е отишъл в друг таб: декодер,
  // компоновка и `backdrop-filter` в трите клетки, за кадър, който никой не
  // вижда. `.rest` спира анимациите с CSS, видеото се пауза направо.
  let inView = true, tabOn = !document.hidden;
  const settle = () => {
    const awake = inView && tabOn;
    hero.classList.toggle('rest', !awake);
    if (awake) { if (v.paused && v.currentSrc) v.play().catch(() => {}); }
    else if (!v.paused) v.pause();
  };
  new IntersectionObserver(([e]) => { inView = e.isIntersecting; settle(); }).observe(hero);
  document.addEventListener('visibilitychange', () => { tabOn = !document.hidden; settle(); });
})();

// дълбочина: кадърът се измества съвсем малко след показалеца
if (!reduce && matchMedia('(pointer:fine)').matches) {
  const hero = document.querySelector('.hero') as HTMLElement;
  const shot = document.getElementById('shot') as HTMLElement;
  // Мишката праща до няколкостотин събития в секунда, а всяко пипаше
  // преобразуването на видеото през целия екран. Сега пише най-много веднъж на
  // кадър: последното положение се запомня и се прилага в следващия кадър.
  let px = 0, py = 0, queued = false;
  const apply = () => {
    queued = false;
    shot.style.setProperty('--px', px + 'px');
    shot.style.setProperty('--py', py + 'px');
  };
  hero.addEventListener('pointermove', (e) => {
    const r = hero.getBoundingClientRect();
    px = ((e.clientX - r.left) / r.width - .5) * -18;
    py = ((e.clientY - r.top) / r.height - .5) * -12;
    if (!queued) { queued = true; requestAnimationFrame(apply); }
  }, { passive: true });
  hero.addEventListener('pointerleave', () => {
    shot.style.setProperty('--px', '0px'); shot.style.setProperty('--py', '0px');
  });
}
</script>

<script>
// Стената: останалите марки се отварят с копчето. Останалите скриптове на тази
// страница вече са в компонентите — избирачът в Picker.astro, формата в
// ContactForm.astro.
const moreBtn = document.getElementById('moreBtn');
if (moreBtn) moreBtn.onclick = () => {
  const box = document.getElementById('carsRest')!;
  const open = box.hidden;
  box.hidden = !open;
  moreBtn.setAttribute('aria-expanded', String(open));
  moreBtn.querySelector('span')!.textContent = open ? 'Скрий останалите' : `Още ${box.children.length} марки`;
};
</script>
</Base>
