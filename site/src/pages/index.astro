---
// НОВИЯТ САЙТ — начален екран.
//
// Базата НЕ се мигрира и НЕ се сваля. Старият сайт (www.pdktuning.com) продължава да
// работи и остава единственият ѝ пазител; тук няма нито един запис от каталога.
// Всяко ниво на избирача се пита на живо през public/_worker.js → /api/live/*.
//
// Дизайнът е одобреният: бранд таблото в Canva (черно #080808 + киселинно зелено
// #52FB09, „Всеки автомобил има потенциал / Ние знаем как да го отключим") плюс
// компоненти от 21st.dev — Crypto Hero (8759), Experience Hero (9724),
// Pixel Logo Grid (12815), Feature Velocity (18901), Multi-Step Form (8281).
//
// Общото (глава, лента, долен ред, бисквитки) е в src/layouts/Base.astro.
import Base from '../layouts/Base.astro';
import Picker from '../components/Picker.astro';
import MarkGrid from '../components/MarkGrid.astro';
import ContactForm from '../components/ContactForm.astro';
import Promo from '../components/Promo.astro';
import HomeShell from '../components/HomeShell.astro';
import business from '../data/business.json';
import prices from '../data/prices.json';
import marks from '../data/marks.json';
import { FEATURED, ICONS, SERVICES } from '../data/services';
import { CATEGORIES } from '../data/categories';
import { FAQ_HOME } from '../data/faq';
import { ARTICLES } from '../data/articles';
import { EV_COUNT, EV_BY_BRAND } from '../data/ev';

// Емблемите са АКТУАЛНИТЕ знаци на марките, събрани от Simple Icons и Уикиданни
// (свойство „лого“ → файл в Commons). Стоят в public/marks. За марките без чист
// знак в свободен източник се показва името, набрано в Oswald.
type Mark = { slug: string; name: string; kind: string; ext: string | null };
const all = marks as Mark[];

// Популярните при нас — показват се едро отпред. Списъкът е НАШ избор и се
// пипа само тук; останалите се отварят с копчето под тях.
const TOP = ['bmw', 'mercedes-benz', 'volkswagen', 'audi', 'opel-vauxhall', 'ford',
  'renault', 'peugeot', 'citroen', 'skoda', 'toyota', 'fiat', 'volvo', 'seat',
  'nissan', 'honda', 'hyundai', 'kia', 'mazda', 'mini'];

/** марките с електрически модели — за лентата под избирача */
const evBrands = EV_BY_BRAND.map((b) => b.name).join(', ');

const cars = all.filter((m) => m.kind === 'леки');
const byTop = (a: Mark, b: Mark) => TOP.indexOf(a.slug) - TOP.indexOf(b.slug);
const carsTop = cars.filter((m) => TOP.includes(m.slug)).sort(byTop);
const carsRest = cars.filter((m) => !TOP.includes(m.slug));

// Камионите и селскостопанската техника вече имат СВОИ страници — етикетът
// отляво е връзка към тях, а не мъртъв надпис.
const groups = CATEGORIES.filter((c) => c.kind !== 'леки').map((c) => {
  const items = all.filter((m) => m.kind === c.kind);
  return { cat: c, items, note: `${items.length} марки` };
});
const carsCat = CATEGORIES.find((c) => c.kind === 'леки')!;

// ── услуги: шестте отбелязани в src/data/services.ts, цените от prices.json ──
// Списъкът стоеше вграден тук и вече беше на две места. Сега е едно.
const P = prices.items as Record<string, { from: number; time: string }>;
const services = FEATURED;

// ── въпросите, които наистина ни задават ──────────────────────────────────
// Списъкът вече живее в src/data/faq.ts, защото го ползва и /vaprosi/.
// Текстът тук е СЪЩИЯТ, който отива и в структурираните данни по-долу —
// FAQPage важи само когато отговорът се вижда на страницата.
const faq = FAQ_HOME;

// ── структурирани данни ───────────────────────────────────────────────────
// Оценката от Google НЕ се маркира: правилата на Google не признават оценка,
// която фирмата слага сама за себе си, без отзивите да се виждат на страницата.
const b = business;
const site = Astro.site!.href.replace(/\/$/, '');
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AutoRepair',
    '@id': `${site}/#business`,
    name: b.name,
    legalName: b.legalName,
    url: `${site}/`,
    image: `${site}/img/pdk-hero.jpg`,
    logo: `${site}/icons/icon-512.png`,
    telephone: b.phoneIntl,
    email: b.email,
    priceRange: '€€',
    // Идентификаторите излизат в схемата САМО ако наистина ги имаме — празен
    // `taxID` е по-лош от липсващ, защото твърди нещо и не го казва.
    ...(b.eik ? { identifier: b.eik, taxID: b.eik } : {}),
    ...(b.vat ? { vatID: b.vat } : {}),
    address: {
      '@type': 'PostalAddress',
      streetAddress: b.address.street,
      addressLocality: b.address.city,
      postalCode: b.address.postalCode,
      addressCountry: b.address.country,
    },
    geo: { '@type': 'GeoCoordinates', latitude: b.geo.lat, longitude: b.geo.lng },
    openingHoursSpecification: b.hours.map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.days,
      opens: h.opens,
      closes: h.closes,
    })),
    areaServed: { '@type': 'City', name: 'Варна' },
    sameAs: [b.social.facebook, b.social.instagram, b.social.youtube],
    // всичките тринайсет услуги, не само шестте на екрана
    makesOffer: SERVICES.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.name,
        description: s.short,
        url: `${site}/uslugi/${s.slug}/`,
      },
      ...(s.priceKey && P[s.priceKey]
        ? { price: P[s.priceKey].from, priceCurrency: prices.currency }
        : {}),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    url: `${site}/`,
    name: `${b.name}, чип тунинг Варна`,
    inLanguage: 'bg-BG',
    publisher: { '@id': `${site}/#business` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const days: Record<string, string> = {
  Monday: 'понеделник', Tuesday: 'вторник', Wednesday: 'сряда', Thursday: 'четвъртък',
  Friday: 'петък', Saturday: 'събота', Sunday: 'неделя',
};
const hoursText = b.hours.map((h) => {
  const d = h.days.length > 1 ? `${days[h.days[0]]} – ${days[h.days[h.days.length - 1]]}` : days[h.days[0]];
  return { d: d.charAt(0).toUpperCase() + d.slice(1), t: `${h.opens} – ${h.closes}` };
});
---

<Base
  title="PDK Tuning, чип тунинг и софтуерни ремонти във Варна"
  description="Чип тунинг с измерване на собствен стенд, DPF, EGR и AdBlue във Варна. Изберете двигателя си и вижте реалните числа преди и след."
  schema={schema}
>
  <Fragment slot="head">
    <!-- само това, което рисува първия екран; останалите шрифтове идват при нужда -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-400-cyrillic.woff2" crossorigin />
    <link rel="preload" as="image" href="/img/pdk-hero2.webp" fetchpriority="high" />
  </Fragment>

<section class="hero">
  <div class="shot">
    <video id="shot" poster="/img/pdk-hero2.webp" muted loop playsinline preload="none"
           width="1470" height="630" aria-hidden="true"></video>
  </div>
  <div class="smoke" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="stagelines" aria-hidden="true"></div>
  <div class="sweep" aria-hidden="true"></div>
  <div class="hud" aria-hidden="true">
    <span class="cn tl"></span><span class="cn tr"></span><span class="cn bl"></span><span class="cn br"></span>
    <div class="ticks"></div>
  </div>

  <div class="inner">
    <div class="left">
      <div class="live"><i class="dot"></i><span>PDK Tuning // Варна // {new Date().getFullYear() - business.yearsExperience}</span></div>

      <div>
        <p class="eyebrow">Всеки автомобил има потенциал</p>
        <h1><span class="lead">Ние знаем как да го</span><span class="out">отключим</span></h1>
        <p class="sub">Анализ · Настройка · Оптимизация, измерено на собствен стенд</p>
      </div>

      <div class="power">
        <div class="p-head">
          <span>Стоково <b>190</b></span>
          <span class="p-mid">BMW 320d · 2015–2019</span>
          <span>PDK <b id="gnum">190</b></span>
        </div>
        <div class="p-bar"><i id="gval"></i></div>
      </div>

      <div class="cta">
        <a class="circle" href="#picker">
          <i><svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17L17 7M17 7H8M17 7V16" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></i>
          <b>Изберете своя автомобил</b>
        </a>
        <a class="tel" href={`tel:${business.phone}`}><b>{business.phoneDisplay}</b></a>
      </div>
    </div>

    <div class="deck">
      <div class="cell">
        <span class="id">001 // Мощност</span>
        <div class="row"><b class="cell-val" id="hHp" data-to="30">+0</b><span class="unit">к.с.</span><span class="track"><i></i></span></div>
      </div>
      <div class="cell">
        <span class="id">002 // Въртящ момент</span>
        <div class="row"><b class="cell-val" id="hNm" data-to="40">+0</b><span class="unit">Nm</span><span class="track"><i style="width:74%"></i></span></div>
      </div>
      {/*
        ТУК СТОЕШЕ клетка „Източникът“: база `pdktuning.com`, четене „на живо,
        без копие“. Тя обясняваше как е УСТРОЕН сайтът — на посетителя това не
        му трябва, а на конкурент му върши работа. Сега клетката казва какво
        покрива сервизът. Числата идват от marks.json, не са преписани.
      */}
      <div class="cell">
        <span class="id">003 // Обхватът</span>
        <div class="kv"><span>{carsCat.wallLabel}</span><span><b>{cars.length}</b> марки</span></div>
        {groups.map((g) => (
          <div class="kv"><span>{g.cat.wallLabel}</span><span><b>{g.items.length}</b> марки</span></div>
        ))}
      </div>
    </div>
  </div>
</section>

<Picker />

{/* Електрическите — рекламата изскача веднъж на 14 дни, този вход стои винаги. */}
<section class="ev-band" aria-labelledby="ev-band-h">
  <div class="ev-band-in">
    <div>
      <p class="ev-band-kick">Ново направление</p>
      <h2 id="ev-band-h">Вече и за <em>електрически автомобили</em></h2>
      <p class="ev-band-p">
        {EV_COUNT} модела на {evBrands}. Заводът ги продава с ограничена мощност;
        разликата е в софтуера. Записва се дистанционно, през телефона, без да идвате до Варна.
      </p>
    </div>
    <a class="btn btn--go ev-band-go" href="/elektricheski/">Вижте своя модел →</a>
  </div>
</section>

<section class="wall" id="catalog">
  <div class="wall-in">
    <div class="wall-head">
      <h2 class="kick">Каталогът</h2>
      <p class="wall-sum"><b id="wCount">—</b> марки в сервиза</p>
    </div>

    <div class="row big">
      <div class="row-lab">
        <h3><a href={`/${carsCat.slug}/`}>{carsCat.wallLabel}</a></h3>
        <span>{cars.length} марки в базата</span>
      </div>
      <MarkGrid marks={carsTop} big />
    </div>

    <div class="more">
      <button id="moreBtn" type="button" aria-expanded="false" aria-controls="carsRest">
        <span>Още {carsRest.length} марки</span>
        <i aria-hidden="true"></i>
      </button>
      <MarkGrid marks={carsRest} id="carsRest" hidden />
    </div>

    {groups.map((g) => (
      <div class="row">
        <div class="row-lab">
          <h3><a href={`/${g.cat.slug}/`}>{g.cat.wallLabel}</a></h3>
          <span>{g.note}</span>
        </div>
        <MarkGrid marks={g.items} />
      </div>
    ))}

    <p class="wall-more">
      <a href="/katalog/">Целият каталог, всички {all.length} марки →</a>
    </p>
  </div>
</section>

<section class="srv" id="services">
  <div class="in">
    <div class="top">
      <h2>Чип тунинг<br />и софтуерни ремонти.</h2>
      <p class="note">Диагностика преди файл. Ако проблемът е датчик, го казваме и не пишем нищо.</p>
    </div>
    <div class="tiles">
      {services.map((s) => (
        <a class="tile" href={`/uslugi/${s.slug}/`}>
          <span class="wash"></span>
          <div class="body">
            <span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><Fragment set:html={ICONS[s.icon]} /></svg></span>
            <div>
              <span class="lab">{s.kicker}</span>
              <h3>{s.name}</h3>
              <p>{s.short}<br />{s.priceKey && P[s.priceKey] && <><b>от {P[s.priceKey].from} €</b> · {P[s.priceKey].time}</>}</p>
              <span class="tile-go">Вижте услугата →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <p class="srv-more"><a href="/uslugi/">Всички {SERVICES.length} услуги →</a></p>
  </div>
</section>

<section class="faq" id="faq">
  <div class="in">
    <div class="top">
      <h2>Въпросите,<br />които ни задавате.</h2>
      <p class="note">Кратки отговори, без заобикаляне. Ако нещо липсва, обадете се.</p>
    </div>
    <div class="qa">
      {faq.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            <h3>{f.q}</h3>
            <i aria-hidden="true"></i>
          </summary>
          <div class="ans"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
    <p class="srv-more"><a href="/vaprosi/">Всички въпроси и отговори →</a></p>
  </div>
</section>

<section class="reads">
  <div class="in">
    <div class="top">
      <h2>Преди да<br />решите.</h2>
      <p class="note">Написано, за да отговори на въпрос, не за да заеме място между две ключови думи.</p>
    </div>
    <div class="reads-list">
      {ARTICLES.slice(0, 3).map((a) => (
        <a class="read" href={`/blog/${a.slug}/`}>
          <span class="read-lab">{a.kicker} · {a.minutes} мин</span>
          <h3>{a.h1}</h3>
          <p>{a.lead}</p>
        </a>
      ))}
    </div>
    <p class="srv-more"><a href="/blog/">Всички статии →</a></p>
  </div>
</section>

<section class="cnt" id="contact">
  <div class="in">
    <div class="cnt-info">
      <h2>Запазете час.</h2>
      <p class="note">Пишете ни или се обадете. Отговаряме в рамките на работния ден.</p>

      <dl class="nas-dl">
        <dt>Адрес</dt>
        <dd>
          <a href={business.social.maps} target="_blank" rel="noopener noreferrer">
            {business.address.street}, {business.address.city} {business.address.postalCode}
          </a>
        </dd>
        <dt>Телефон</dt>
        <dd><a href={`tel:${business.phone}`}>{business.phoneDisplay}</a></dd>
        <dt>Имейл</dt>
        <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
        <dt>Работно време</dt>
        <dd>
          {hoursText.map((h) => <span class="nas-hours"><b>{h.d}</b>{h.t}</span>)}
          <span class="nas-hours"><b>Неделя</b>почивен ден</span>
        </dd>
      </dl>
    </div>

    <ContactForm />
  </div>
</section>

<Promo />

<HomeShell />

<script>
// Стената: останалите марки се отварят с копчето. Останалите скриптове на тази
// страница вече са в компонентите — избирачът в Picker.astro, формата в
// ContactForm.astro.
const moreBtn = document.getElementById('moreBtn');
if (moreBtn) moreBtn.onclick = () => {
  const box = document.getElementById('carsRest')!;
  const open = box.hidden;
  box.hidden = !open;
  moreBtn.setAttribute('aria-expanded', String(open));
  moreBtn.querySelector('span')!.textContent = open ? 'Скрий останалите' : `Още ${box.children.length} марки`;
};
</script>
</Base>
