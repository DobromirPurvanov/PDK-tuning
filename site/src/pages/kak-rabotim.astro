---
/**
 * „КАК РАБОТИМ?“ — заглавие от собствения им речник (таблото в Canva).
 * Страницата описва процеса от обаждането до връщането на колата.
 */
import Page from '../layouts/Page.astro';
import { crumbSchema, bizRef } from '../lib/seo';
import { BUSINESS as b } from '../config/site';

const site = Astro.site!.href.replace(/\/$/, '');
const crumbs = [{ href: '/kak-rabotim/', label: 'Как работим' }];

const steps = [
  { t: 'Обаждане или запитване', d: 'Казвате марка, модел, двигател и какво ви притеснява или какво искате от колата. Още тук се вижда дали работата е за нас.' },
  { t: 'Записване на час', d: 'Уговаряме ден. За Stage 2, трансмисии и селскостопанска техника се планира предварително, защото работата е в няколко хода.' },
  { t: 'Диагностика', d: 'Пълно сканиране на всички блокове, живи стойности и замразени кадри. Това не е формалност — оттук се решава дали изобщо се пише файл.' },
  { t: 'Разговор преди работа', d: 'Казваме какво сме видели, какво предлагаме и колко струва. Ако колата не е готова, го чувате тук.' },
  { t: 'Замерване на стенд', d: 'Първата крива. Тя е стартовата точка и доказателството какво е било преди намесата.' },
  { t: 'Архивиране на оригинала', d: 'Фабричният файл се сваля и се пази. Оттук нататък връщането назад е въпрос на минути, не на преговори.' },
  { t: 'Работата', d: 'Файл, ремонт или и двете. Ако по време на работата излезе нещо ново, спираме и питаме — не довършваме и не представяме сметката накрая.' },
  { t: 'Втора крива и предаване', d: 'Замерваме отново и сравняваме. Получавате разпечатката, а колата — с обяснение какво е променено.' },
];

const rules = [
  { t: 'Диагностика преди файл — винаги', d: 'Запис върху болна кола не подобрява нищо. Той ускорява края на болната част, а вината после пада върху файла.' },
  { t: 'Оригиналът се пази', d: 'Преди всяка промяна. Връщането назад не е услуга, за която се пазарим — то е част от работата.' },
  { t: 'Казваме и когато не си струва', d: 'Атмосферен бензинов двигател, кола в гаранция дни преди края, машина с износен съединител. Отказаната работа е по-евтина от лошата.' },
  { t: 'Не изключваме системи за коли на пътя', d: 'DPF, EGR и AdBlue се изключват само за техника извън обществените пътища. За автомобил на пътя работим по ремонта.' },
  { t: 'Числата се измерват, не се обещават', d: 'Две криви от един и същ стенд, в един и същ ден. Всичко останало е реклама.' },
];

const schema = [
  bizRef(site),
  crumbSchema(site, [{ href: '/', label: 'Начало' }, ...crumbs]),
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Как минава чип тунинг в PDK Tuning',
    description: 'Осемте стъпки от обаждането до предаването на колата.',
    step: steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.t,
      text: s.d,
    })),
  },
];
---
<Page
  title="Как работим — от обаждането до колата | PDK Tuning"
  description="Осем стъпки: диагностика преди файл, архивиране на оригинала, замерване на стенд преди и след. И петте правила, от които не отстъпваме."
  kicker="Процесът"
  heading="Как работим"
  lead="Един и същ ред при всяка кола. Той съществува, защото прескочената стъпка се плаща по-късно и по-скъпо."
  crumbs={crumbs}
  schema={schema}
>
  <div class="p-wrap">
    <section class="p-sec">
      <h2>Осемте стъпки</h2>
      <div class="p-steps">
        {steps.map((s) => (
          <div class="p-step">
            <div><h3>{s.t}</h3><p>{s.d}</p></div>
          </div>
        ))}
      </div>
    </section>

    <section class="p-sec">
      <h2>От какво не отстъпваме</h2>
      <p class="p-note">Пет правила, които струват поръчки — и точно затова ги пишем.</p>
      <div class="p-steps">
        {rules.map((r) => (
          <div class="p-step">
            <div><h3>{r.t}</h3><p>{r.d}</p></div>
          </div>
        ))}
      </div>
    </section>

    <section class="p-sec">
      <h2>Колко време остава колата</h2>
      <div class="p-prose">
        <p>
          Диагностика — около половин час. Stage 1 — между два и четири часа, обикновено в
          рамките на един ден. Замерване на стенд — тридесет до четиридесет и пет минути.
        </p>
        <p>
          Stage 2 и работата по трансмисии се планират предварително, защото настройката
          минава през няколко записа със замерване между тях. Софтуерният ремонт на блок
          зависи от състоянието — казваме срока, след като видим дали блокът изобщо отговаря.
        </p>
        <p>
          При селскостопанска техника се съобразяваме с кампанията: машина, спряна в кампания,
          струва повече от самата услуга. Уговаряме деня предварително и се стремим да върнем
          машината същия ден.
        </p>
        <p>
          Работно време и адрес — в <a href="/kontakti/">контакти</a>. Телефонът е{' '}
          <a href={`tel:${b.phone}`}>{b.phoneDisplay}</a>.
        </p>
      </div>
    </section>
  </div>
</Page>
