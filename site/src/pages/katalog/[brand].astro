---
/**
 * THE HUNDRED AND TEN BRAND PAGES.
 *
 * The database is NOT copied here: the page has not a single engine written
 * statically. The live picker under the text starts ALREADY SET to this brand and
 * queries the old site at the moment of opening.
 *
 * The text is unique for each brand (`src/data/brand-notes.ts`). This is not
 * decoration: a hundred and ten pages with the same paragraph and a changed name are exactly
 * the definition of doorway pages.
 */
import Page from '../../layouts/Page.astro';
import Picker from '../../components/Picker.astro';
import MarkGrid from '../../components/MarkGrid.astro';
import marks from '../../data/marks.json';
import { noteFor } from '../../data/brand-notes';
import { CAT_BY_KIND } from '../../data/categories';
import { BY_SLUG as SVC, ICONS } from '../../data/services';
import { crumbSchema, bizRef, pickDesc, pickTitle } from '../../lib/seo';

type Mark = { slug: string; name: string; kind: string; ext: string | null };
const all = marks as Mark[];

export function getStaticPaths() {
  return (marks as Mark[]).map((m) => ({ params: { brand: m.slug } }));
}

const { brand } = Astro.params;
const m = all.find((x) => x.slug === brand)!;
const cat = CAT_BY_KIND.get(m.kind as any)!;
const note = noteFor(m.slug);

// neighbours in the same category, so the page is not a dead end
const siblings = all.filter((x) => x.kind === m.kind && x.slug !== m.slug);
const nearby = siblings.slice(0, 24);

const services = cat.services.slice(0, 3).map((s) => SVC.get(s)!).filter(Boolean);

const site = Astro.site!.href.replace(/\/$/, '');
const crumbs = [
  { href: '/katalog/', label: 'Каталог' },
  { href: `/${cat.slug}/`, label: cat.name },
  { href: `/katalog/${m.slug}/`, label: m.name },
];

// Names range from 3 characters ("MG") to 21 ("Mercedes-Benz Trucks"). One template for
// all pushes the long brands past 158 characters and Google cuts the sentence in the
// middle. The variants go from longest to shortest.
// The same goes for the title: "Mercedes-Benz Trucks" brings the template to 77 characters,
// and Google cuts around 60 and the brand drops off first, which is exactly what must
// survive. The variants go from most descriptive to shortest.
const pageTitle = pickTitle(
  `Чип тунинг ${m.name}, числа преди и след | PDK Tuning`,
  `Чип тунинг ${m.name}, Варна | PDK Tuning`,
  `Чип тунинг ${m.name} | PDK Tuning`,
);

const description = pickDesc(
  `Чип тунинг, диагностика и софтуерни ремонти за ${m.name} във Варна. Изберете модела, годината и двигателя и вижте мощността преди и след, на живо от базата.`,
  `Чип тунинг и софтуерни ремонти за ${m.name} във Варна. Изберете модел, година и двигател и вижте мощността преди и след, на живо от базата.`,
  `Чип тунинг за ${m.name} във Варна. Изберете модел, година и двигател и вижте мощността преди и след, на живо от базата ни.`,
);

const schema = [
  bizRef(site),
  crumbSchema(site, [{ href: '/', label: 'Начало' }, ...crumbs]),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Чип тунинг ${m.name}`,
    description: `Чип тунинг и софтуерни ремонти за ${m.name} във Варна.`,
    url: `${site}/katalog/${m.slug}/`,
    provider: { '@id': `${site}/#business` },
    areaServed: { '@type': 'City', name: 'Варна' },
    brand: { '@type': 'Brand', name: m.name },
  },
];
---
<Page
  title={pageTitle}
  description={description}
  kicker={cat.name}
  heading={`Чип тунинг ${m.name}`}
  lead={`Изберете модела и двигателя в избирача и ще видите числата за конкретния двигател, не средни стойности за марката.`}
  crumbs={crumbs}
  schema={schema}
  ctaTitle={`Твоят ${m.name}.`}
  ctaText="Кажете ни двигателя и пробега. Започваме с диагностика, не с оферта."
>
  <div class="p-wrap">
    <section class="p-sec">
      <div class="p-split">
        <div class="p-prose">
          <h2>Какво да очаквате от {m.name}</h2>
          {note
            ? <p>{note}</p>
            : <p>Марката е в базата ни с реални стойности преди и след за всеки двигател.
                Изберете модела и годината в избирача. Числата са за конкретния двигател, не общо правило.</p>}
          {cat.body[0] && cat.body[0].p.map((t) => <p>{t}</p>)}
          <p>
            Повече за работата ни с {cat.name.toLowerCase()} има
            <a href={`/${cat.slug}/`}>на страницата на категорията</a>.
          </p>
        </div>

        <aside class="p-facts panel">
          <h2>{m.name}</h2>
          <dl>
            <dt>Категория</dt>
            <dd><a href={`/${cat.slug}/`} style="color:inherit;border-bottom:1px solid var(--line-soft)">{cat.name}</a></dd>
            <dt>Марки в категорията</dt>
            <dd>{siblings.length + 1}</dd>
            <dt>Източник на числата</dt>
            <dd>живата база, без копие</dd>
            <dt>Преди файл</dt>
            <dd>винаги диагностика</dd>
          </dl>
        </aside>
      </div>
    </section>
  </div>

  <Picker
    heading={`Изберете двигателя на ${m.name}`}
    sub="Модел, година, двигател. Числата идват от базата в момента на избора."
    brand={m.slug}
  />

  <div class="p-wrap">
    <section class="p-sec">
      <h2>Услуги за {m.name}</h2>
      <div class="p-cards three">
        {services.map((s) => (
          <a class="p-card panel panel--link" href={`/uslugi/${s.slug}/`}>
            <span class="wash"></span>
            <span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><Fragment set:html={ICONS[s.icon]} /></svg></span>
            <span class="lab">{s.kicker}</span>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="go">Вижте услугата →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="p-sec">
      <h2>Други марки в {cat.name.toLowerCase()}</h2>
      <p class="p-note">{siblings.length} марки в същата категория.</p>
      <MarkGrid marks={nearby} />
      {siblings.length > nearby.length && (
        <p class="p-prose" style="margin-top:24px">
          <a href={`/${cat.slug}/`}>Вижте всички {siblings.length + 1} марки в {cat.name.toLowerCase()} →</a>
        </p>
      )}
    </section>
  </div>
</Page>
