---
/**
 * THE THREE CATEGORY PAGES: /leki-avtomobili/, /kamioni/,
 * /selskostopanska-tehnika/.
 *
 * This is the neglected asset: trucks (7 brands) and agricultural machinery
 * (19 brands) have existed in the database for years, but the old site had neither
 * an entry page nor a word of text for them. Twenty-six brands with no competition.
 *
 * The route is dynamic but NOT broad: `getStaticPaths` returns exactly the three
 * addresses, so no other path is caught by it.
 */
import Page from '../layouts/Page.astro';
import MarkGrid from '../components/MarkGrid.astro';
import { CATEGORIES, CAT_BY_SLUG } from '../data/categories';
import { BY_SLUG as SVC, ICONS } from '../data/services';
import marks from '../data/marks.json';
import { crumbSchema, bizRef } from '../lib/seo';

type Mark = { slug: string; name: string; kind: string; ext: string | null };

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const c = CAT_BY_SLUG.get(category!)!;

const all = marks as Mark[];
const mine = all.filter((m) => m.kind === c.kind);

const site = Astro.site!.href.replace(/\/$/, '');
const crumbs = [
  { href: '/katalog/', label: 'Каталог' },
  { href: `/${c.slug}/`, label: c.name },
];

const services = c.services.map((s) => SVC.get(s)!).filter(Boolean);

const schema = [
  bizRef(site),
  crumbSchema(site, [{ href: '/', label: 'Начало' }, ...crumbs]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Марки — ${c.name}`,
    numberOfItems: mine.length,
    itemListElement: mine.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: m.name,
      url: `${site}/katalog/${m.slug}/`,
    })),
  },
];
---
<Page
  title={c.title}
  description={c.description}
  kicker={`${mine.length} марки в базата`}
  heading={c.h1}
  lead={c.lead}
  crumbs={crumbs}
  schema={schema}
>
  <div class="p-wrap">
    <section class="p-sec">
      <h2>Какво печели тази техника</h2>
      <p class="p-note">Обичайни стойности. Точното число за конкретния двигател е в каталога.</p>
      <table class="tbl">
        <thead><tr><th>Какво</th><th>Колко</th></tr></thead>
        <tbody>
          {c.gains.map((g) => (
            <tr>
              <td data-l="Какво">{g.k}</td>
              <td data-l="Колко"><b>{g.v}</b></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="p-sec">
      <h2>Марките</h2>
      <p class="p-note">Всяка води към страницата си с живия избирач.</p>
      <MarkGrid marks={mine} big={mine.length <= 20} />
    </section>

    <section class="p-sec">
      <div class="p-prose">
        {c.body.map((sec) => (
          <>
            <h2>{sec.h}</h2>
            {sec.p.map((t) => <p>{t}</p>)}
          </>
        ))}
      </div>
    </section>

    <section class="p-sec">
      <h2>Услуги за {c.name.toLowerCase()}</h2>
      <div class="p-cards three">
        {services.map((s) => (
          <a class="p-card panel panel--link" href={`/uslugi/${s.slug}/`}>
            <span class="wash"></span>
            <span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><Fragment set:html={ICONS[s.icon]} /></svg></span>
            <span class="lab">{s.kicker}</span>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="go">Вижте услугата →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="p-sec">
      <h2>Другите категории</h2>
      <div class="p-cards three">
        {CATEGORIES.filter((x) => x.slug !== c.slug).map((x) => (
          <a class="p-card panel panel--link" href={`/${x.slug}/`}>
            <span class="wash"></span>
            <span class="lab">{all.filter((m) => m.kind === x.kind).length} марки</span>
            <h3>{x.name}</h3>
            <p>{x.lead}</p>
            <span class="go">Вижте категорията →</span>
          </a>
        ))}
        <a class="p-card panel panel--link" href="/katalog/">
          <span class="wash"></span>
          <span class="lab">{all.length} марки</span>
          <h3>Целият каталог</h3>
          <p>Всички марки на едно място, с търсене и живия избирач.</p>
          <span class="go">Вижте каталога →</span>
        </a>
      </div>
    </section>
  </div>
</Page>
