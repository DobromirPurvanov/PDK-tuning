---
/**
 * За партньорските сервизи и дилъри.
 *
 * ВАЖНО: порталът за файлове ОСТАВА на стария сървър и не се пренася. Тази
 * страница само обяснява как се работи с него и води към него — всяка друга
 * промяна би счупила отметките на партньорите, които го ползват от години.
 */
import Page from '../layouts/Page.astro';
import { crumbSchema, bizRef } from '../lib/seo';
import { BUSINESS as b, PORTAL } from '../config/site';

const site = Astro.site!.href.replace(/\/$/, '');
const crumbs = [{ href: '/za-dileri/', label: 'За дилъри' }];
const schema = [bizRef(site), crumbSchema(site, [{ href: '/', label: 'Начало' }, ...crumbs])];

const flow = [
  { t: 'Достъп', d: 'Профилът се урежда индивидуално — обаждате се, уговаряме условията и получавате данни за вход в портала.' },
  { t: 'Качване на файла', d: 'Прочитате блока при вас и качвате оригиналния файл през портала, заедно с данните за колата и какво се иска.' },
  { t: 'Обработка', d: 'Пишем файла и го връщаме в същия профил. Сроковете зависят от типа работа и се уговарят предварително.' },
  { t: 'Записване при вас', d: 'Свалятe готовия файл и го записвате на място. Ако нещо не тръгне, сме на телефона.' },
];
---
<Page
  title="За дилъри и сервизи — портал за файлове | PDK Tuning"
  description="Партньорски условия за сервизи: качване на оригинален файл през портала, готов файл обратно в същия профил. Достъпът се урежда индивидуално."
  kicker="Партньори"
  heading="За дилъри и сервизи"
  lead="Част от работата ни идва от други сервизи. Те четат блока при себе си, качват файла и получават готовия обратно."
  crumbs={crumbs}
  schema={schema}
  ctaTitle="Искате достъп?"
  ctaText="Обадете се. Условията се уговарят според обема, а не по таблица."
>
  <div class="p-wrap">
    <section class="p-sec">
      <div class="p-split">
        <div class="p-prose">
          <h2>Какво представлява портала</h2>
          <p>
            Порталът е отделна система, в която партньорските сервизи качват прочетени файлове и
            получават обработените обратно. Той работи от години и има свои потребители —
            затова остава на мястото си и не се пипа. Адресът му не се променя.
          </p>
          <p>
            Този сайт не е порталът. Той е витрината: обяснява какво правим, показва числата от
            каталога и приема запитвания от крайни клиенти. Двете системи са отделни нарочно.
          </p>

          <h2>Кой работи така</h2>
          <p>
            Сервизи, които имат диагностика и оборудване за четене и запис, но не пишат файлове
            сами. Те вършат механичната част при себе си, а софтуерната идва от нас. За клиента
            това е един сервиз, а не два.
          </p>

          <h2>Какво очакваме от партньора</h2>
          <p>
            Коректен прочит на оригинала и вярна информация за колата — хардуерен номер, двигател,
            пробег, състояние. Файл, писан по грешни данни, не работи, а времето е загубено и от
            двете страни.
          </p>
          <p>
            Очакваме и същата граница, която пазим ние: за автомобил, който се движи по обществени
            пътища, не изключваме системи за пречистване на изгорели газове. Работим по ремонта.
          </p>

          <h2>Условия</h2>
          <p>
            Цените за партньори са отделни от <a href="/tseni/">публичния ценоразпис</a> и се
            уговарят според обема. Няма таблица, която да важи за всички — сервиз с два файла на
            месец и сервиз с двайсет не са един и същ разговор.
          </p>
        </div>

        <aside class="p-facts">
          <h2>Достъп</h2>
          <dl>
            <dt>Порталът</dt>
            <dd>
              <a href={PORTAL} target="_blank" rel="noopener noreferrer"
                 style="color:var(--lime);border-bottom:1px solid rgba(82,251,9,.4)">Вход за партньори ↗</a>
            </dd>
            <dt>Нов профил</dt>
            <dd>по телефон, след разговор</dd>
            <dt>Телефон</dt>
            <dd><a href={`tel:${b.phone}`} style="color:inherit;border-bottom:1px solid rgba(255,255,255,.2)">{b.phoneDisplay}</a></dd>
            <dt>Имейл</dt>
            <dd><a href={`mailto:${b.email}`} style="color:inherit;border-bottom:1px solid rgba(255,255,255,.2)">{b.email}</a></dd>
          </dl>
        </aside>
      </div>
    </section>

    <section class="p-sec">
      <h2>Как минава един файл</h2>
      <div class="p-steps">
        {flow.map((f) => (
          <div class="p-step">
            <div><h3>{f.t}</h3><p>{f.d}</p></div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Page>
