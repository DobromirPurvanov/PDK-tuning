---
/**
 * „How we work“ — огледало на `src/pages/kak-rabotim.astro`.
 * Същите осем стъпки и същите пет правила; текстът е писан наново.
 */
import Page from '../../layouts/Page.astro';
import { crumbSchema, bizRef } from '../../lib/seo';
import { BUSINESS as b } from '../../config/site';

const site = Astro.site!.href.replace(/\/$/, '');
const crumbs = [{ href: '/en/how-we-work/', label: 'How we work' }];

const steps = [
  { t: 'Call or enquiry', d: 'You tell us the make, model and engine, and either what worries you or what you want from the car. Even at this point it is usually clear whether the job is one for us.' },
  { t: 'Booking', d: 'We agree a day. Stage 2, transmission work and agricultural machinery are planned in advance, because the work runs in several passes.' },
  { t: 'Diagnostics', d: 'A full scan of every module, live data and freeze frames. This is not a formality: it decides whether a file gets written at all.' },
  { t: 'The conversation before the work', d: 'We tell you what we found, what we propose and what it costs. If the car is not ready, you hear it here.' },
  { t: 'Baseline dyno run', d: 'The first curve. It is the starting point and the record of what the car produced before we touched it.' },
  { t: 'Archiving the original', d: 'The factory file is read and kept. From then on, going back is a matter of minutes rather than negotiation.' },
  { t: 'The work', d: 'A file, a repair, or both. If something new appears during the job, we stop and ask. We do not finish and present the bill at the end.' },
  { t: 'Second curve and handover', d: 'We measure again and compare. You get the printout, and the car comes back with an explanation of what changed.' },
];

const rules = [
  { t: 'Always diagnostics before any file', d: 'Writing to a sick car improves nothing. It brings forward the failure of the sick part, and the file gets the blame afterwards.' },
  { t: 'The original is kept', d: 'Before every change. Returning to standard is not a service to be haggled over; it is part of the job.' },
  { t: 'We say so when it is not worth it', d: 'A naturally aspirated petrol engine, a car days from the end of its warranty, a machine with a worn clutch. Work turned down is cheaper than work done badly.' },
  { t: 'We do not delete systems on road cars', d: 'DPF, EGR and AdBlue are switched off only for machines outside public roads. For a car on the road, we repair the system.' },
  { t: 'Figures are measured, not promised', d: 'Two curves from the same dyno on the same day. Everything else is advertising.' },
];

const schema = [
  bizRef(site, 'en'),
  crumbSchema(site, [{ href: '/en/', label: 'Home' }, ...crumbs]),
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How chip tuning works at PDK Tuning',
    description: 'The eight steps from the first call to handing the car back.',
    inLanguage: 'en',
    step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.t, text: s.d })),
  },
];
---
<Page
  title="How we work, from the call to the car | PDK Tuning"
  description="Eight steps: diagnostics before any file, the original archived, dyno runs before and after. And the five rules we do not bend."
  kicker="The process"
  heading="How we work"
  lead="The same order for every car. It exists because a skipped step gets paid for later, and at a higher price."
  crumbs={crumbs}
  schema={schema}
>
  <div class="p-wrap">
    <section class="p-sec">
      <h2>The eight steps</h2>
      <div class="p-steps">
        {steps.map((s) => (
          <div class="p-step">
            <div><h3>{s.t}</h3><p>{s.d}</p></div>
          </div>
        ))}
      </div>
    </section>

    <section class="p-sec">
      <h2>What we do not bend on</h2>
      <p class="p-note">Five rules that cost us work. That is exactly why we write them down.</p>
      <div class="p-steps">
        {rules.map((r) => (
          <div class="p-step">
            <div><h3>{r.t}</h3><p>{r.d}</p></div>
          </div>
        ))}
      </div>
    </section>

    <section class="p-sec">
      <h2>How long the car stays</h2>
      <div class="p-prose">
        <p>
          Diagnostics take about half an hour. Stage 1 runs between two and four hours,
          usually within a single day. A dyno session is thirty to forty-five minutes.
        </p>
        <p>
          Stage 2 and transmission work are planned in advance, because the calibration goes
          through several writes with measurement in between. ECU software repair depends on
          the state of the unit, and we give a timescale once we have seen whether the ECU
          responds at all.
        </p>
        <p>
          With agricultural machinery we work around the season: a machine standing still
          during harvest costs more than the service itself. We agree the day in advance and
          aim to return the machine the same day.
        </p>
        <p>
          Opening hours and address are on the <a href="/en/contact/">contact page</a>. The
          phone number is <a href={`tel:${b.phone}`}>{b.phoneIntl}</a>.
        </p>
      </div>
    </section>
  </div>
</Page>
