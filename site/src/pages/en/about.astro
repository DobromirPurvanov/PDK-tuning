---
/**
 * "About", mirror of src/pages/za-nas.astro.
 *
 * Follows the client's own text of 2026-09-26: no number tiles, no company
 * panel, no map link. Same facts as the Bulgarian page, written in English.
 * The partner page (/za-dileri/) exists only in Bulgarian, so partners are
 * sent to the English contact page instead.
 */
import Page from '../../layouts/Page.astro';
import { crumbSchema, bizRef } from '../../lib/seo';
import { BUSINESS as b } from '../../config/site';

const site = Astro.site!.href.replace(/\/$/, '');
const crumbs = [{ href: '/en/about/', label: 'About' }];
const schema = [bizRef(site, 'en'), crumbSchema(site, [{ href: '/en/', label: 'Home' }, ...crumbs])];
---
<Page
  title="About PDK Tuning, chip tuning in Varna"
  description={`A workshop in Varna with its own dyno and ${b.yearsExperience} years of work on engine control unit software. We work with car owners and with partner workshops.`}
  kicker="Who we are"
  heading="About us"
  lead={`PDK Tuning is a workshop in Varna with its own power dyno. We have ${b.yearsExperience} years of experience with engine control unit software. Our customers are car owners and the workshops we work with on software calibration.`}
  crumbs={crumbs}
  schema={schema}
>
  <div class="p-wrap">
    <section class="p-sec">
      <div class="p-prose">
        <h2>What we do</h2>
        <p>
          We work on the software of vehicle control units. Our services include chip tuning,
          Stage 2, automatic gearbox calibration and recovering control units after a failed
          write.
        </p>
        <p>
          We work with car owners and with partner workshops that send us software to process.
        </p>

        <h2>Dyno measurement</h2>
        <p>
          We have our own dyno for measuring power and torque. When a measurement is part of the
          service, we compare the results before and after the calibration on the same dyno and
          show you the graphs.
        </p>

        <h2>When we advise against tuning</h2>
        <p>
          Not every change makes sense for every car. If we find a technical fault, we first
          recommend having it fixed. For engines with limited potential we explain what result
          to expect, so you can decide whether the service is worth it for you.
        </p>
        <p>
          If the car is under warranty, we also discuss how a software change may affect it
          before we start work.
        </p>

        <h2>Partner workshops</h2>
        <p>
          The workshops we work with can send files and receive the finished calibrations
          through a separate partner portal. Access is arranged individually; ask us on the
          <a href="/en/contact/">contact page</a>.
        </p>
      </div>
    </section>

    <section class="p-sec">
      <h2>Get in touch</h2>
      <div class="p-prose">
        <p>
          {b.legalName}<br />
          Phone: <a href={`tel:${b.phone}`}>{b.phoneIntl}</a><br />
          Email: <a href={`mailto:${b.email}`}>{b.email}</a>
        </p>
        <p>
          We work with customers from Varna and with partner workshops elsewhere. For visits,
          opening hours and enquiries, see the <a href="/en/contact/">contact page</a>.
        </p>
      </div>
    </section>
  </div>
</Page>
