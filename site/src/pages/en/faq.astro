---
/**
 * Questions and answers, mirror of src/pages/vaprosi.astro.
 *
 * The FAQPage schema is built from the SAME list that is drawn, so the schema
 * never promises answers that are not on the screen.
 */
import Page from '../../layouts/Page.astro';
import { FAQ_EN, FAQ_GROUPS_EN } from '../../i18n/en/faq';
import { SERVICES_EN } from '../../i18n/en/services/index';
import { crumbSchema, faqSchema, bizRef } from '../../lib/seo';

const site = Astro.site!.href.replace(/\/$/, '');
const crumbs = [{ href: '/en/faq/', label: 'Questions' }];

const groups = FAQ_GROUPS_EN
  .map((g) => ({ g, items: FAQ_EN.filter((f) => f.group === g) }))
  .filter((grp) => grp.items.length);

/** services with their own questions: we link to them instead of repeating them */
const withFaq = SERVICES_EN.filter((s) => s.faq?.length);

const schema = [
  bizRef(site, 'en'),
  crumbSchema(site, [{ href: '/en/', label: 'Home' }, ...crumbs]),
  { ...faqSchema(FAQ_EN.map(({ q, a }) => ({ q, a }))), inLanguage: 'en' },
];
---
<Page
  title="Chip tuning questions and answers | PDK Tuning"
  description="Warranty, engine risk, returning the factory software, DPF and AdBlue. Short, direct answers from a chip tuning workshop in Varna, with no promises."
  kicker={`${FAQ_EN.length} questions`}
  heading="Questions and answers"
  lead="Short answers. If your question is not here, call us and ask."
  crumbs={crumbs}
  schema={schema}
  ctaTitle="Still have a question?"
  ctaText="Call us. We also answer the questions that end with “it is not worth it”."
>
  <div class="p-wrap">
    {groups.map((grp) => (
      <section class="p-sec">
        <h2>{grp.g}</h2>
        <div class="qa">
          {grp.items.map((f, i) => (
            <details name={`qa-${grp.g}`} open={i === 0}>
              <summary><h3>{f.q}</h3><i aria-hidden="true"></i></summary>
              <div class="ans"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </section>
    ))}

    {withFaq.length > 0 && (
      <section class="p-sec">
        <h2>Questions about a specific service</h2>
        <p class="p-note">The answers are on the service page itself.</p>
        <div class="p-prose">
          <ul>
            {withFaq.map((s) => (
              <li style="margin-bottom:10px">
                <a href={`/en/services/${s.slug}/`}>{s.name}</a> · {s.faq!.length === 1 ? 'one question' : `${s.faq!.length} questions`}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </div>
</Page>

<style is:global>
.p-prose ul{margin:0 0 18px;padding-left:22px}
.p-prose li{margin:0 0 var(--sp-2);font:400 var(--fz-body)/1.7 var(--body);color:var(--ink-2)}
.p-prose li::marker{color:var(--lime)}
</style>
