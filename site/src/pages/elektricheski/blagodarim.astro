---
/**
 * After payment: this is where Stripe returns on success (`success_url`).
 *
 * It deliberately does NOT claim "payment accepted" as a fact. The page is static and
 * knows nothing: it is returned by a foreign server and anyone can open it directly by
 * typing the address. Confirmation of the money comes from the bank and from the email, not from here.
 * So the text says what FOLLOWS, not what has happened.
 *
 * `noindex`: there is nothing for it to do in the index and it should not show up for
 * someone who has not ordered.
 */
import Page from '../../layouts/Page.astro';
import { BUSINESS as b } from '../../config/site';

const crumbs = [
  { href: '/elektricheski/', label: 'Електрически автомобили' },
  { href: '/elektricheski/blagodarim/', label: 'Благодарим' },
];
---
<Page
  title="Благодарим, поръчката е при нас | PDK Tuning"
  description="Поръчката е приета. Обаждаме се да сверим модела с автомобила, преди устройството да тръгне."
  kicker="Готово"
  heading="Благодарим"
  lead="Поръчката е при нас. Оттук нататък работата е наша, но първо ще чуете човек."
  crumbs={crumbs}
  noindex={true}
  cta={false}
>
  <div class="p-wrap">
    <section class="p-sec">
      <div class="p-split">
        <div class="p-prose">
          <h2>Какво следва</h2>
          <p>
            Обаждаме се в рамките на работния ден, за да сверим модела и годината с
            автомобила ви. Това не е формалност: сгрешен блок значи файл, който не върши
            работа, а проверката отнема един въпрос.
          </p>
          <p>
            След това PDK Flasher тръгва към адреса ви. Когато пристигне, отваряте
            приложението, изчитате оригиналния софтуер и той идва при нас автоматично.
            Готовият файл се връща на същия екран.
          </p>
          <h2>Ако нещо не е наред</h2>
          <p>
            Ако не сте получили нищо от нас до края на следващия работен ден, или сте
            видели грешка при плащането, обадете се на
            <a href={`tel:${b.phone}`}>{b.phoneDisplay}</a> или пишете на
            <a href={`mailto:${b.email}`}>{b.email}</a>. По-добре един излишен разговор,
            отколкото поръчка, която стои.
          </p>
          <p>
            Правата ви при отказ и рекламация са разписани в
            <a href="/otkaz-i-reklamacii/">Отказ и рекламации</a>.
          </p>
        </div>

        <aside class="p-facts panel">
          <h2>Връзка</h2>
          <dl>
            <dt>Телефон</dt><dd><a href={`tel:${b.phone}`}>{b.phoneDisplay}</a></dd>
            <dt>Имейл</dt><dd><a href={`mailto:${b.email}`}>{b.email}</a></dd>
            <dt>Адрес</dt><dd>{b.address.street}, {b.address.city}</dd>
          </dl>
          <p class="p-prose" style="margin:18px 0 0">
            <a href="/elektricheski/">Обратно към електрическите →</a>
          </p>
        </aside>
      </div>
    </section>
  </div>
</Page>
