---
/**
 * ЕЛЕКТРИЧЕСКИТЕ — входната страница на новото направление.
 *
 * Тук се събират две неща: кои електрически модели поемаме (данните са в
 * src/data/ev.ts) и как работи PDK Flasher, с който клиентът си записва
 * файла сам, без да идва до Варна.
 *
 * Числата в текста НЕ се пишат на ръка. „33 модела“ и най-голямата разлика
 * идват от данните — иначе един ден ще пише 33, а в избирача ще има 40.
 */
import Page from '../../layouts/Page.astro';
import EvPicker from '../../components/EvPicker.astro';
import { EV_COUNT, EV_BY_BRAND, money } from '../../data/ev';
import { crumbSchema, faqSchema, bizRef } from '../../lib/seo';
// стъпките и екраните на приложението живеят в данните — ползва ги и /pdk-flasher/
import { FLASHER_STEPS, FLASHER_APP } from '../../data/flasher';

const site = Astro.site!.href.replace(/\/$/, '');
const crumbs = [{ href: '/elektricheski/', label: 'Електрически автомобили' }];

const brandLine = EV_BY_BRAND.map((b) => b.name).join(', ');

const faq = [
  {
    q: 'Наистина ли не трябва да идвам до сервиза?',
    a: 'При поддържаните модели не е нужно. Целият път (четене, изпращане, получаване и запис) минава през PDK Flasher и приложението. Устройството се доставя до вас и остава ваше. Дали вашият автомобил се поддържа, проверяваме предварително.',
  },
  {
    q: 'Защо при електрическия автомобил изобщо има какво да се подобри?',
    a: 'Защото при някои модели производителят предлага версии с различна мощност. Това не означава, че всяка версия има еднакъв хардуер, затова проверяваме конкретния автомобил, преди да кажем какво е възможно.',
  },
  {
    q: 'Какво значи „таван на блока“ в избирача?',
    a: 'Докъдето управляващият блок на този модел изобщо пуска, това е факт за автомобила, не обещание какво ще постигнем ние. Нашето число за всеки модел стои отделно и там, където още не е обявено, го пише честно.',
  },
  {
    q: 'Какво става с гаранцията?',
    a: 'Промяната на заводския софтуер може да е основание сервизът да откаже гаранционен ремонт по задвижването. Казваме го на входа. Оригиналът се архивира и се връща по всяко време, но записът оставя следа в брояча на блока. Не обещаваме невидимост.',
  },
  {
    q: 'Може ли автомобилът да се върне в първоначалното си състояние?',
    a: 'Да. Оригиналният файл се пази и се записва обратно със същото устройство и същото приложение, без да ни търсите за среща.',
  },
  {
    q: 'Моделът ми не е в списъка.',
    a: `Списъкът тръгва с ${EV_COUNT} модела на ${brandLine} и расте. Пишете ни кой е автомобилът, и ако блокът му е познат, ще ви отговорим направо дали го поемаме и кога.`,
  },
];

const schema = [
  bizRef(site),
  crumbSchema(site, [{ href: '/', label: 'Начало' }, ...crumbs]),
  faqSchema(faq),
];
---
<Page
  title="Тунинг на електрически автомобили | PDK Tuning"
  description="Софтуерни настройки за определени модели електрически автомобили. Проверяваме конкретния автомобил, преди да кажем каква настройка е възможна."
  kicker="Ново направление"
  heading="Софтуерни настройки за електрически автомобили"
  lead="За определени модели предлагаме софтуерни настройки, които могат да променят характеристиките на автомобила. Възможностите зависят от конкретния модел, версията на софтуера и оборудването. Ако автомобилът се поддържа, ще ви обясним как протича услугата и дали може да се извърши дистанционно."
  crumbs={crumbs}
  schema={schema}
  ctaTitle="Кажете ни автомобила."
  ctaText="Ако моделът още не е в списъка, пак ни пишете. По-добре да чуете „не го поемаме“, отколкото да чакате."
>
  <div class="p-wrap">
    <section class="p-sec">
        <div class="p-prose">
          <h2>Какво може да се промени</h2>
          <p>
            При някои електрически автомобили производителят предлага версии с различна мощност.
            Това обаче не означава, че всяка версия има еднакъв хардуер или че разликата може да
            бъде премахната само със софтуер.
          </p>
          <p>
            Затова проверяваме конкретния автомобил, преди да кажем каква настройка е възможна и
            какъв резултат може да се очаква.
          </p>
          <h2>Какво е важно да знаете</h2>
          <p>
            Не обещаваме резултат за модел, който не сме проверили, нито че промяната ще остане
            незабележима при сервизна диагностика. Настройката може да има значение и за
            гаранцията на автомобила.
          </p>
          <p>
            Ако за даден модел все още нямаме потвърдени резултати, го посочваме ясно, вместо да
            представяме данни от друг автомобил като резултат за вашия.
          </p>
        </div>
    </section>
  </div>

  <EvPicker
    heading="Изберете своя автомобил"
    sub="Марка, после модел. Числата и цената излизат веднага."
  />

  <div class="p-wrap">
    <section class="p-sec">
      <h2>Как става, без да идвате</h2>
      <div class="p-steps">
        {FLASHER_STEPS.map((s) => (
          <div class="p-step">
            <div><h3>{s.t}</h3><p>{s.d}</p></div>
          </div>
        ))}
      </div>
    </section>

    <section class="p-sec">
      <h2>Какво още има в приложението</h2>
      <p class="p-note">
        Подробно за самото устройство четете в <a href="/pdk-flasher/">PDK Flasher</a>.
      </p>
      <div class="p-steps">
        {FLASHER_APP.map((a) => (
          <div class="p-step">
            <div><h3>{a.t}</h3><p>{a.d}</p></div>
          </div>
        ))}
      </div>
    </section>

    <section class="p-sec">
      <h2>Моделите, които поемаме</h2>
      <p class="p-note">
        Числото вдясно е фабричната мощност в нормален режим и таванът на управляващия
        блок. Цената и нашето число се виждат в страницата на модела.
      </p>
      <div class="ev-table">
        {EV_BY_BRAND.map((b) => (
          <section class="ev-group">
            <h3>{b.name}</h3>
            <ul>
              {b.models.map((m) => (
                <li>
                  <a href={m.href}>
                    <span class="n">{m.name}</span>
                    <span class="y">{m.years}</span>
                    <span class="p">{m.stockPs} → {m.ceilingPs} к.с.</span>
                    <span class="c">{money(m.price)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section class="p-sec">
      <h2>Въпросите, които ни задават</h2>
      <div class="qa">
        {faq.map((f, i) => (
          <details name="evfaq" open={i === 0}>
            <summary><h3>{f.q}</h3><i aria-hidden="true"></i></summary>
            <div class="ans"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </section>
  </div>
</Page>

<style>
.ev-table{display:grid;gap:34px}
.ev-group h3{margin:0 0 var(--h-gap-card);font:700 var(--fz-s)/1 var(--head);text-transform:uppercase;letter-spacing:.06em;color:var(--lime)}
.ev-group ul{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}
.ev-group a{display:grid;gap:4px 16px;grid-template-columns:1fr auto;align-items:baseline;
  padding:13px 2px;border-bottom:1px solid var(--line);transition:var(--t-fast)}
.ev-group a:hover{background:var(--tint-1)}
.ev-group .n{font:400 var(--fz-body)/1.3 var(--body);color:var(--white)}
.ev-group .y{font:400 var(--fz-btn)/1 var(--mono);color:var(--ink-5);text-align:right}
.ev-group .p{font:400 var(--fz-2xs)/1 var(--mono);color:var(--ink-4);font-variant-numeric:tabular-nums}
.ev-group .c{font:400 var(--fz-2xs)/1 var(--mono);color:var(--lime);text-align:right;white-space:nowrap}
.ev-group a:hover .n{color:var(--lime)}
@media(min-width:760px){
  .ev-table{grid-template-columns:1fr 1fr;gap:34px 48px}
  .ev-group a{grid-template-columns:1fr 90px 150px 130px}
  .ev-group .y,.ev-group .p{text-align:left}
}
@media(min-width:1060px){.ev-table{grid-template-columns:1fr}}
</style>
