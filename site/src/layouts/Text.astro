---
/**
 * Обвивка за страниците, които са само текст — правните и подобните.
 * Типографията е една: мярка около 70 знака, дишащи заглавия, четим сив.
 */
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  /** „в сила от“ — датата стои под заглавието и се вижда от читателя */
  updated?: string;
  lead?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}
const { heading, updated, lead, ...head } = Astro.props;
---
<Base {...head} ogType="article">
  <article class="doc">
    <header class="doc-head">
      <p class="doc-kick">PDK Tuning</p>
      <h1>{heading}</h1>
      {lead && <p class="doc-lead">{lead}</p>}
      {updated && <p class="doc-date">В сила от {updated}</p>}
    </header>
    <div class="doc-body">
      <slot />
    </div>
  </article>
</Base>

<style is:global>
/* Таблицата е примитив (`.tbl` в `styles/ui.css`) — правните страници я ползват
   както всяка друга. Тук остава само типографията на дългия текст. */
.doc{max-width:var(--w-text);margin:0 auto;padding:150px var(--gut) 96px}
@media(max-width:759px){.doc{padding:120px var(--gut) 72px}}

.doc-head{padding-bottom:var(--sp-6);margin-bottom:var(--sp-7);border-bottom:1px solid var(--line)}
.doc-kick{margin:0 0 var(--sp-4);font:400 var(--fz-lab)/1 var(--mono);
  letter-spacing:var(--ls-lab);text-transform:uppercase;color:var(--lime)}
.doc h1{margin:0;font:700 clamp(2.2rem,5.6vw,4rem)/.98 var(--head);
  letter-spacing:var(--ls-tight);text-transform:uppercase}
.doc-lead{margin:var(--sp-5) 0 0;max-width:var(--w-read);
  font:400 var(--fz-m)/1.6 var(--body);color:var(--ink-2)}
.doc-date{margin:var(--sp-4) 0 0;font:400 var(--fz-btn)/1 var(--mono);
  letter-spacing:var(--ls-btn);text-transform:uppercase;color:var(--ink-4)}

.doc-body{max-width:var(--w-prose)}
.doc-body h2{margin:var(--sp-8) 0 var(--sp-4);font:700 var(--fz-h3)/1.15 var(--head);
  letter-spacing:var(--ls-h3);text-transform:uppercase}
.doc-body h2:first-child{margin-top:0}
.doc-body h3{margin:var(--sp-6) 0 var(--sp-3);font:700 var(--fz-h4)/1.3 var(--head);
  text-transform:uppercase;letter-spacing:.01em;color:var(--lime)}
.doc-body p{margin:0 0 var(--sp-4);font:400 var(--fz-body)/1.7 var(--body);color:var(--ink-2)}
.doc-body ul,.doc-body ol{margin:0 0 var(--sp-4);padding-left:var(--sp-5)}
.doc-body li{margin:0 0 var(--sp-2);font:400 var(--fz-body)/1.7 var(--body);color:var(--ink-2)}
.doc-body li::marker{color:var(--lime)}
.doc-body a{color:var(--lime);border-bottom:1px solid var(--lime-line)}
.doc-body a:hover{border-bottom-color:var(--lime)}
.doc-body strong{color:var(--white);font-weight:400}
.doc-body dl{margin:0 0 var(--sp-4)}
.doc-body dt{margin-top:var(--sp-4);font:400 var(--fz-xs)/1.4 var(--mono);color:var(--white)}
.doc-body dd{margin:var(--sp-1) 0 0;font:400 var(--fz-s)/1.6 var(--body);color:var(--ink-3)}
.doc-body .tbl{margin:0 0 var(--sp-5)}
</style>
