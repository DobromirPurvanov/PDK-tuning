---
/**
 * Обвивката на ВСЯКА вътрешна страница — услуги, категории, марки, статии,
 * фирмени страници.
 *
 * `Text.astro` остава за правните: там текстът е една колона и нищо друго.
 * Тук има трошици, заглавен блок, разделите на съдържанието и заключително
 * действие. Класовете са с представка `p-`, за да не се блъснат с общите
 * имена от началната (`row`, `col`, `tile`, `in`, `top`…) — веднъж `bar` вече
 * ни струва два кръга гледане в грешния елемент.
 */
import Base from './Base.astro';
import { BUSINESS as b, portalUrl } from '../config/site';
import { langOf } from '../i18n';
import { dict } from '../i18n/ui';

export type Crumb = { href: string; label: string };

interface Props {
  title: string;
  description: string;
  /** микро-етикетът над заглавието */
  kicker?: string;
  heading: string;
  lead?: string;
  /** без началната — тя се добавя сама */
  crumbs?: Crumb[];
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  /** заключителният блок с телефона; изключва се само там, където пречи */
  cta?: boolean;
  ctaTitle?: string;
  ctaText?: string;
}
const lang = langOf(Astro.url.pathname);
const t = dict(lang);
const portal = portalUrl(lang);

/* Подразбиранията на заключителния блок идват от речника, не от подписа на
   компонента: зашити български низове тук значеха български призив под всяка
   английска страница. Страница, която ги подава сама, ги надвива както преди. */
const {
  kicker,
  heading,
  lead,
  crumbs = [],
  cta = true,
  ctaTitle = t.ctaTitle,
  ctaText = t.ctaText,
  ...head
} = Astro.props;

const trail: Crumb[] = [{ href: lang === 'en' ? '/en/' : '/', label: t.home }, ...crumbs];
---
<Base {...head}>
  <div class="p-top">
    <nav class="crumbs" aria-label={t.trailAria}>
      <ol>
        {trail.map((c, i) => (
          <li>
            {i < trail.length - 1
              ? <a href={c.href}>{c.label}</a>
              : <span aria-current="page">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>

    <header class="p-hero">
      {kicker && <p class="p-kick">{kicker}</p>}
      <h1>{heading}</h1>
      {lead && <p class="p-lead">{lead}</p>}
    </header>
  </div>

  <slot />

  {cta && (
    <section class="p-cta">
      <div class="p-cta-in">
        <div>
          <h2>{ctaTitle}</h2>
          <p>{ctaText}</p>
        </div>
        <div class="p-cta-do">
          <a class="btn btn--go" href={`tel:${b.phone}`}>{b.phoneDisplay}</a>
          <a class="btn" href={lang === 'en' ? '/en/contact/' : '/kontakti/'}>{t.ctaWrite}</a>
          <a class="btn btn--ghost" href={portal} target="_blank" rel="noopener noreferrer">{t.portal}</a>
        </div>
      </div>
    </section>
  )}
</Base>

<style is:global>
/* Трошиците, бутонът, таблицата, акордеонът, плочата и полето „чака данни“ са
   примитиви и живеят в `styles/ui.css`. Тук остава само това, което е СОБСТВЕНО
   на вътрешната страница. */

/* ── заглавен блок ──────────────────────────────────────────────────────── */
.p-top{max-width:var(--w-page);margin:0 auto;padding:132px var(--gut) 0}
@media(max-width:759px){.p-top{padding-top:104px}}

.p-hero{padding:var(--sp-6) 0 var(--sp-7);margin-bottom:0;border-bottom:1px solid var(--line)}
.p-kick{margin:0 0 var(--sp-4);font:400 var(--fz-lab)/1 var(--mono);
  letter-spacing:var(--ls-lab);text-transform:uppercase;color:var(--lime)}
.p-hero h1{margin:0;max-width:19ch;font:700 var(--fz-h1)/.96 var(--head);
  letter-spacing:var(--ls-tight);text-transform:uppercase}
.p-lead{margin:var(--h-gap) 0 0;max-width:60ch;font:400 var(--fz-l)/1.6 var(--body);color:var(--ink-2)}

/* ── общият контейнер на разделите ──────────────────────────────────────── */
.p-wrap{max-width:var(--w-page);margin:0 auto;padding:0 var(--gut)}
.p-sec{padding:var(--sec-y) 0}
.p-sec + .p-sec{border-top:1px solid var(--line)}
.p-sec > h2{margin:0 0 var(--h-gap);font:700 var(--fz-h2)/1.04 var(--head);
  letter-spacing:var(--ls-snug);text-transform:uppercase}
/* Бележката е ПОДЗАГЛАВЕН ред, не съдържание — стои с една стъпка по-близо до
   заглавието, отколкото съдържанието. Преди това се постигаше с отрицателен
   марджин върху бележката: двете правила се изваждаха и никое от тях не казваше
   колко е отстоянието накрая. */
.p-sec > h2:has(+ .p-note){margin-bottom:var(--h-gap-tight)}
.p-sec > .p-note{margin:0 0 var(--h-gap);max-width:56ch;
  font:400 var(--fz-lab)/1.85 var(--mono);
  letter-spacing:var(--ls-lab);text-transform:uppercase;color:var(--ink-4)}

/* ── проза ──────────────────────────────────────────────────────────────── */
/* ВНИМАНИЕ С НИВАТА. Когато разделът НЯМА свое `.p-sec > h2`, заглавията в
   прозата СА заглавията на раздела и трябва да са `h2` — иначе страницата
   скача от h1 на h3. Точно това чупеше 126 от 144 страници.
   Затова h2 и h3 тук изглеждат ЕДНАКВО: нивото се избира по смисъл, а
   външният вид не се мени според това дали разделът има собствено заглавие. */
.p-prose{max-width:var(--w-prose)}
.p-prose h2,.p-prose h3{margin:var(--sp-7) 0 var(--h-gap-tight);font:700 var(--fz-h3)/1.2 var(--head);
  text-transform:uppercase;letter-spacing:var(--ls-h3)}
.p-prose h2:first-child,.p-prose h3:first-child{margin-top:0}
.p-prose p{margin:0 0 var(--sp-4);font:400 var(--fz-body)/1.72 var(--body);color:var(--ink-2)}
.p-prose a{color:var(--lime);border-bottom:1px solid var(--lime-line)}
.p-prose a:hover{border-bottom-color:var(--lime)}
.p-prose strong{color:var(--white);font-weight:400}

/* ── двуколонният разрез: текст вляво, сухи числа вдясно ────────────────── */
.p-split{display:grid;gap:var(--sp-7);grid-template-columns:1fr}
@media(min-width:980px){.p-split{grid-template-columns:1fr 320px;gap:var(--sp-8);align-items:start}}

/* ── списъци „за кого е“ / „кога няма смисъл“ ───────────────────────────── */
.p-lists{display:grid;gap:var(--sp-5);grid-template-columns:1fr}
@media(min-width:760px){.p-lists{grid-template-columns:1fr 1fr}}
.p-list{padding:var(--sp-5)}
.p-list h3{margin:0 0 var(--h-gap-tight);font:400 var(--fz-lab)/1 var(--mono);
  letter-spacing:var(--ls-lab);text-transform:uppercase}
.p-list.yes h3{color:var(--lime)}
.p-list.no h3{color:var(--warn)}
.p-list ul{margin:0;padding:0;list-style:none}
.p-list li{position:relative;margin:0 0 var(--sp-3);padding-left:var(--sp-5);
  font:400 var(--fz-s)/1.6 var(--body);color:var(--ink-2)}
.p-list li::before{position:absolute;left:0;top:0;font:400 var(--fz-s)/1.7 var(--mono)}
.p-list.yes li::before{content:'+';color:var(--lime)}
.p-list.no li::before{content:'−';color:var(--warn)}

/* ── стъпките: номерирана пътека ────────────────────────────────────────── */
.p-steps{counter-reset:st;display:grid;gap:0;max-width:74ch}
.p-step{counter-increment:st;display:grid;grid-template-columns:auto 1fr;gap:0 var(--sp-5);
  padding:var(--sp-5) 0;border-bottom:1px solid var(--line)}
.p-step:last-child{border-bottom:0}
.p-step::before{content:counter(st,decimal-leading-zero);
  font:400 var(--fz-btn)/1.5 var(--mono);letter-spacing:var(--ls-btn);color:var(--lime)}
.p-step h3{margin:0 0 var(--h-gap-card);font:700 var(--fz-h4)/1.25 var(--head);
  text-transform:uppercase;letter-spacing:.005em}
.p-step p{margin:0;font:400 var(--fz-s)/1.65 var(--body);color:var(--ink-3)}

/* ── сухите числа отстрани ──────────────────────────────────────────────── */
.p-facts{position:sticky;top:104px;padding:var(--sp-5)}
@media(max-width:979px){.p-facts{position:static}}
/* Заглавието на страничната колона е `h2`: тя е самостоятелен раздел на
   страницата, а не подраздел на прозата до нея. */
.p-facts h2,.p-facts h3{margin:0 0 var(--h-gap-tight);font:400 var(--fz-lab)/1 var(--mono);
  letter-spacing:var(--ls-lab);text-transform:uppercase;color:var(--lime)}
.p-facts dl{margin:0}
.p-facts dt{font:400 var(--fz-lab)/1.5 var(--mono);letter-spacing:var(--ls-btn);
  text-transform:uppercase;color:var(--ink-4)}
.p-facts dd{margin:var(--sp-1) 0 0;font:400 var(--fz-s)/1.5 var(--body);color:var(--white)}
.p-facts dd + dt{margin-top:var(--sp-4);padding-top:var(--sp-4);border-top:1px solid var(--line)}
.p-price{margin:var(--sp-5) 0 0;padding-top:var(--sp-4);border-top:1px solid var(--line)}
.p-price b{display:block;font:700 30px/1 var(--head);color:var(--lime);font-variant-numeric:tabular-nums}
.p-price span{display:block;margin-top:var(--sp-2);font:400 var(--fz-btn)/1.5 var(--mono);color:var(--ink-4)}

/* ── карти: услуги, категории, статии ───────────────────────────────────── */
.p-cards{display:grid;gap:var(--sp-4);grid-template-columns:1fr}
@media(min-width:700px){.p-cards{grid-template-columns:1fr 1fr}}
@media(min-width:1060px){.p-cards.three{grid-template-columns:repeat(3,1fr)}}
/* фонът, рамката и радиусът идват от `.panel`; тук е само своето на картата */
.p-card{position:relative;display:block;overflow:hidden;padding:var(--sp-6) var(--sp-6) var(--sp-5)}
.p-card .wash{position:absolute;inset:0;opacity:0;transition:opacity var(--t-slow);
  background:linear-gradient(135deg,var(--lime-wash) 0%,transparent 62%)}
.p-card:hover .wash{opacity:1}
.p-card > * {position:relative;z-index:var(--z-base)}
.p-card .ic{width:48px;height:48px;margin-bottom:var(--sp-5);border-radius:var(--r-m);
  background:var(--tint-2);display:grid;place-items:center}
.p-card .ic svg{width:22px;height:22px;stroke:var(--lime);stroke-width:1.8;fill:none;
  stroke-linecap:round;stroke-linejoin:round}
.p-card .lab{display:block;margin-bottom:var(--sp-3)}
.p-card h3{margin:0 0 var(--h-gap-card);font:700 clamp(19px,2vw,25px)/1.08 var(--head);
  letter-spacing:var(--ls-h3);text-transform:uppercase}
.p-card p{margin:0;font:400 var(--fz-xs)/1.62 var(--mono);color:var(--ink-4)}
.p-card p b{color:var(--lime);font-weight:400}
.p-card .go{display:inline-block;margin-top:var(--sp-4);font:400 var(--fz-lab)/1 var(--mono);
  letter-spacing:var(--ls-lab);text-transform:uppercase;color:var(--lime);
  opacity:.85;transition:opacity var(--t)}
.p-card:hover .go{opacity:1}

/* ── заключителното действие ────────────────────────────────────────────── */
.p-cta{position:relative;overflow:hidden;margin-top:var(--sp-4);padding:var(--sp-8) var(--gut);
  border-top:1px solid var(--line);background:var(--bg-bar)}
.p-cta::before{content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(45deg,var(--hair) 0px 1px,transparent 1px 8px);
  -webkit-mask-image:radial-gradient(ellipse 70% 60% at 50% 0%,#000 62%,transparent 108%);
  mask-image:radial-gradient(ellipse 70% 60% at 50% 0%,#000 62%,transparent 108%)}
.p-cta-in{position:relative;z-index:var(--z-base);max-width:var(--w-page);margin:0 auto;display:flex;
  flex-wrap:wrap;gap:var(--sp-6);align-items:flex-end;justify-content:space-between}
.p-cta h2{margin:0;font:700 clamp(2rem,4.6vw,3.4rem)/.98 var(--head);
  letter-spacing:var(--ls-tight);text-transform:uppercase}
.p-cta p{margin:var(--h-gap-tight) 0 0;max-width:44ch;font:400 var(--fz-s)/1.65 var(--body);color:var(--ink-3)}
.p-cta-do{display:flex;flex-wrap:wrap;gap:var(--sp-2)}
@media(max-width:619px){.p-cta{padding:var(--sp-8) var(--gut)}.p-cta-do{width:100%}.p-cta-do .btn{flex:1 1 100%}}
</style>
