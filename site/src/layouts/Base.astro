---
/**
 * Обвивката на всяка страница: глава, лента, съдържание, долен ред, бисквитки.
 *
 * Тук стоят САМО общите неща — жетоните на бранда, шрифтовете, нулирането и
 * скелетът. Всичко, което е само за началната, си остава в index.astro.
 */
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import Analytics from '../components/Analytics.astro';
import { langOf } from '../i18n';
import { dict } from '../i18n/ui';
/* Жетоните и примитивите. Внасят се ТУК, за да важат за всяка страница —
   `tokens.css` е единственият източник на цвят, размер и движение, а `ui.css`
   държи нещата, които се срещат на повече от едно място. Виж `docs/DIZAYN.md`. */
import '../styles/tokens.css';
import '../styles/ui.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  /** класове за <body> — началната си боядисва фона другояче */
  bodyClass?: string;
}
const { bodyClass = '', ...head } = Astro.props;
/* Езикът се чете от АДРЕСА, не се подава от страницата — вж. бележката в
   `src/i18n/index.ts`. Сто осемдесет и три страници не могат да го подадат
   правилно сто осемдесет и три пъти. */
const lang = langOf(Astro.url.pathname);
const t = dict(lang);
---
<!doctype html>
<html lang={lang}>
<head>
  <Head {...head} />
  <!--
    Двата шрифта, с които е написан ПЪРВИЯТ екран на всяка страница: Oswald
    рисува заглавията, Golos е `--body`, тоест всеки абзац и всеки бутон.
    Golos липсваше дълго време — теглеше се чак след като браузърът разчете
    вградения CSS, докато моно шрифтът за дребните етикети се дърпаше с
    приоритет. Тоест най-важният текст чакаше заради второстепенния.
    Латинските части и моно шрифтът идват при нужда.
  -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/oswald-700-cyrillic.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/golos-text-400-cyrillic.woff2" crossorigin />
  <slot name="head" />
  <style is:global>
    /* Нулирането. Жетоните, шрифтовете и примитивите идват от `styles/`. */
    *,*::before,*::after{box-sizing:border-box}
    html{scroll-padding-top:88px}
    body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--fz-m)/1.65 var(--body);
      overflow-x:hidden}
    h1,h2,h3,h4{color:var(--white)}
    img{display:block;max-width:100%}
    /* УЛОВКА: правило с `display` от таблицата бие `[hidden]` на браузъра. Така
       скритите марки в каталога и грешките под полетата се виждаха ВЕДНАГА.
       Едно правило спасява всяко бъдещо `hidden` в тази страница. */
    [hidden]{display:none !important}
    a,button{color:inherit;text-decoration:none;font:inherit}
    :focus-visible{outline:2px solid var(--lime);outline-offset:3px;border-radius:var(--r-xs)}
    main:focus{outline:none}
    .skip{position:absolute;left:-9999px;top:0;z-index:var(--z-skip);
      background:var(--lime);color:var(--lime-ink);
      display:inline-flex;align-items:center;min-height:48px;padding:0 20px;
      font:700 var(--fz-2xs)/1 var(--mono);letter-spacing:var(--ls-btn);text-transform:uppercase}
    .skip:focus{left:12px;top:12px}
    /*
      `-webkit-font-smoothing:antialiased` НЕ се слага. На macOS той ИЗТЪНЯВА
      буквите, а Golos при тегло 400 и без това е лек; тънки ярки линии върху
      черно е точно рецептата за трептене. Оставено на `auto` — буквите
      получават тяло.
    */
    @media(prefers-reduced-motion:reduce){
      html{scroll-behavior:auto}
      *,*::before,*::after{animation-duration:.001ms !important;animation-iteration-count:1 !important;
        transition-duration:.001ms !important}
    }
  </style>
</head>
<body class={bodyClass}>
  <a class="skip" href="#content">{t.skip}</a>
  <Header />
  <main id="content" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <Consent />
  <Analytics />
</body>
</html>
