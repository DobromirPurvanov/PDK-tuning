---
/**
 * The shell of every page: head, bar, content, bottom row, cookies.
 *
 * Only the shared things live here — the brand tokens, the fonts, the reset and
 * the skeleton. Everything that is only for the home page stays in index.astro.
 */
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import Analytics from '../components/Analytics.astro';
import { langOf } from '../i18n';
import { dict } from '../i18n/ui';
/* The tokens and primitives. Imported HERE so they apply to every page —
   `tokens.css` is the single source of colour, size and motion, and `ui.css`
   holds the things that occur in more than one place. See `docs/DESIGN.md`. */
import '../styles/tokens.css';
import '../styles/ui.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  /** classes for <body> — the home page paints its background differently */
  bodyClass?: string;
}
const { bodyClass = '', ...head } = Astro.props;
/* The language is read from the URL, not passed by the page — see the note in
   `src/i18n/index.ts`. One hundred and eighty-three pages cannot pass it
   correctly one hundred and eighty-three times. */
const lang = langOf(Astro.url.pathname);
const t = dict(lang);
---
<!doctype html>
<html lang={lang}>
<head>
  <Head {...head} />
  <!--
    The two fonts the FIRST screen of every page is set in: Oswald draws the
    headings, Golos is `--body`, i.e. every paragraph and every button.
    Golos was missing for a long time — it was only fetched after the browser
    parsed the inline CSS, while the mono font for the small labels was pulled
    with priority. That is, the most important text waited for the secondary one.
    The Latin parts and the mono font come on demand.
  -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/oswald-700-cyrillic.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/golos-text-400-cyrillic.woff2" crossorigin />
  <slot name="head" />
  <style is:global>
    /* The reset. Tokens, fonts and primitives come from `styles/`. */
    *,*::before,*::after{box-sizing:border-box}
    html{scroll-padding-top:88px}
    body{margin:0;background:var(--bg);color:var(--ink);font:400 var(--fz-m)/1.65 var(--body);
      overflow-x:hidden}
    h1,h2,h3,h4{color:var(--white)}
    img{display:block;max-width:100%}
    /* GOTCHA: a stylesheet rule with `display` beats the browser's `[hidden]`. That
       is how the hidden makes in the catalogue and the errors under the fields
       showed up IMMEDIATELY. One rule saves every future `hidden` on this page. */
    [hidden]{display:none !important}
    a,button{color:inherit;text-decoration:none;font:inherit}
    :focus-visible{outline:2px solid var(--lime);outline-offset:3px;border-radius:var(--r-xs)}
    main:focus{outline:none}
    .skip{position:absolute;left:-9999px;top:0;z-index:var(--z-skip);
      background:var(--lime);color:var(--lime-ink);
      display:inline-flex;align-items:center;min-height:48px;padding:0 20px;
      font:700 var(--fz-2xs)/1 var(--mono);letter-spacing:var(--ls-btn);text-transform:uppercase}
    .skip:focus{left:12px;top:12px}
    /*
      `-webkit-font-smoothing:antialiased` is NOT set. On macOS it THINS the
      letters, and Golos at weight 400 is light anyway; thin bright lines on
      black are exactly the recipe for shimmer. Left at `auto` — the letters
      get body.
    */
    @media(prefers-reduced-motion:reduce){
      html{scroll-behavior:auto}
      *,*::before,*::after{animation-duration:.001ms !important;animation-iteration-count:1 !important;
        transition-duration:.001ms !important}
    }
  </style>
</head>
<body class={bodyClass}>
  <a class="skip" href="#content">{t.skip}</a>
  <Header />
  <main id="content" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <Consent />
  <Analytics />
</body>
</html>
